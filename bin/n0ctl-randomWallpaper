#!/usr/bin/env bash

wallpapers=(
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Anime-Girl5.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Anime-Purple-eyes.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Anime-Room.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/City-Rainy-Night.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/City-Rain.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Comets-of-that-night.jpg"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Dark_Nature.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Game-GTA.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Balcony-ja.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Dark_window.png"
  "/home/n0ctanedev/Wallpaper-Bank/wallpapers/Fantasy-Japanese-Street.png"
  "/home/n0ctanedev/Downloads/N0ctOS_logo_with_bg.png"
)

rand_index=$(( RANDOM % ${#wallpapers[@]} ))

while [[ "$rand_index" == "$oldRandom" ]]; do
    rand_index=$(( RANDOM % ${#wallpapers[@]} ))
done

export oldRandom="$rand_index"
picked="${wallpapers[$rand_index]}"
n0ctl-wallSwitch $picked



# sleep 0.2

