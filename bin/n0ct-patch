#!/usr/bin/env python3
"""
patcher.py — applies a YAML patch file to the local system.

Usage:
    patcher.py patch.yaml [--dry-run]
    patcher.py --apply-missing [--patches-dir DIR] [--applied-file FILE] [--dry-run]
    patcher.py --all [--patches-dir DIR] [--applied-file FILE] [--dry-run]

Single-patch mode applies one YAML file: pre → pkgs → files → commands → post.

Batch modes scan a patches dir in filename order:
  --apply-missing  only patches not yet listed in the applied file (diff)
  --all            every *.yaml, ignoring the applied file (still registers)

Batch order:
  1. all `pre` blocks, file order
  2. merged packages: last-op-wins per package, remove then install, once
  3. per file in order: files → commands → post, registering each on success
"""

import argparse
import difflib
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

try:
    import jsonschema
    from jsonschema.exceptions import best_match
except ImportError:
    jsonschema = None
    best_match = None


# ---------------------------------------------------------------------------
# Unified rich-text UI
# ---------------------------------------------------------------------------

class UI:
    """Single source for all coloured / formatted output."""

    def __init__(self) -> None:
        self.color = False
        self.verbose = False
        self.auto = False
        self._width = 80

    # --- capability ---------------------------------------------------------

    def configure(self, *, color: str | None = None, verbose: bool = False, auto: bool = False) -> None:
        self.verbose = verbose
        self.auto = auto
        if color is not None:
            self.enable_color(color)

    def enable_color(self, mode: str) -> None:
        """mode: auto | always | never"""
        if mode == "never":
            self.color = False
            return
        if mode == "always":
            self.color = True
            return
        # auto
        no_color = os.environ.get("NO_COLOR")
        color_mode = os.environ.get("COLOR_MODE", "auto").lower()
        if no_color or color_mode == "never":
            self.color = False
        elif color_mode == "always":
            self.color = True
        else:
            self.color = sys.stdout.isatty()

    @property
    def width(self) -> int:
        try:
            return shutil.get_terminal_size().columns
        except OSError:
            return 80

    # --- low-level ----------------------------------------------------------

    def _wrap(self, text: str, code: str) -> str:
        if not self.color:
            return text
        return f"{code}{text}{RESET}"

    def red(self, text: str) -> str:
        return self._wrap(text, RED)

    def green(self, text: str) -> str:
        return self._wrap(text, GREEN)

    def yellow(self, text: str) -> str:
        return self._wrap(text, YELLOW)

    def blue(self, text: str) -> str:
        return self._wrap(text, BLUE)

    def magenta(self, text: str) -> str:
        return self._wrap(text, MAGENTA)

    def cyan(self, text: str) -> str:
        return self._wrap(text, CYAN)

    def white(self, text: str) -> str:
        return self._wrap(text, WHITE)

    def bright_red(self, text: str) -> str:
        return self._wrap(text, BRIGHT_RED)

    def bright_green(self, text: str) -> str:
        return self._wrap(text, BRIGHT_GREEN)

    def bright_yellow(self, text: str) -> str:
        return self._wrap(text, BRIGHT_YELLOW)

    def bright_blue(self, text: str) -> str:
        return self._wrap(text, BRIGHT_BLUE)

    def bright_magenta(self, text: str) -> str:
        return self._wrap(text, BRIGHT_MAGENTA)

    def bright_cyan(self, text: str) -> str:
        return self._wrap(text, BRIGHT_CYAN)

    def bright_white(self, text: str) -> str:
        return self._wrap(text, BRIGHT_WHITE)

    def dim(self, text: str) -> str:
        return self._wrap(text, DIM)

    def bold(self, text: str) -> str:
        return self._wrap(text, BOLD)

    def italic(self, text: str) -> str:
        return self._wrap(text, ITALIC)

    def underline(self, text: str) -> str:
        return self._wrap(text, UNDERLINE)

    def reverse(self, text: str) -> str:
        return self._wrap(text, REVERSE)

    def blink(self, text: str) -> str:
        return self._wrap(text, BLINK)

    def bg_red(self, text: str) -> str:
        return self._wrap(text, BG_RED)

    def bg_green(self, text: str) -> str:
        return self._wrap(text, BG_GREEN)

    def bg_yellow(self, text: str) -> str:
        return self._wrap(text, BG_YELLOW)

    def bg_blue(self, text: str) -> str:
        return self._wrap(text, BG_BLUE)

    # Combinations
    def bold_red(self, text: str) -> str:
        return self._wrap(text, BOLD + RED)

    def bold_green(self, text: str) -> str:
        return self._wrap(text, BOLD + GREEN)

    def bold_yellow(self, text: str) -> str:
        return self._wrap(text, BOLD + YELLOW)

    def bold_blue(self, text: str) -> str:
        return self._wrap(text, BOLD + BLUE)

    def bold_magenta(self, text: str) -> str:
        return self._wrap(text, BOLD + MAGENTA)

    def bold_cyan(self, text: str) -> str:
        return self._wrap(text, BOLD + CYAN)

    def bold_white(self, text: str) -> str:
        return self._wrap(text, BOLD + WHITE)

    # --- semantic -----------------------------------------------------------

    def ok(self, text: str) -> str:
        return self.bold_green("✓") + " " + self.bold(text)

    def err(self, text: str) -> str:
        return self.bold_red("✗") + " " + self.bold(text)

    def warn(self, text: str) -> str:
        return self.bold_yellow("!") + " " + self.bold(text)

    def info(self, text: str) -> str:
        return self.bold_cyan("·") + " " + self.bold(text)

    def note(self, text: str) -> str:
        return self.dim(text)

    def skip(self, text: str) -> str:
        return self.dim("·") + " " + self.dim(text)

    def step(self, text: str) -> str:
        return self.bold_blue("→") + " " + self.bold(text)

    # --- layout -------------------------------------------------------------

    def title(self, text: str, subtitle: str | None = None) -> None:
        w = min(self.width - 4, 70)
        bar = "═" * w
        print(f"\n{self.bold_blue('╭')}{self.bold_blue(bar)}{self.bold_blue('╮')}")
        print(f"  {self.bold_white(text)}")
        if subtitle:
            print(f"  {self.bold_cyan(subtitle)}")
        print(f"{self.bold_blue('╰')}{self.bold_blue(bar)}{self.bold_blue('╯')}")

    def section(self, text: str) -> None:
        w = min(self.width - 4, 60)
        bar = "─" * w
        print(f"\n{self.bold_magenta('──')} {self.bold_magenta(text)} {self.bold_magenta(bar)}")

    def rule(self, char: str = "─") -> None:
        print(self.bold_cyan(char * min(self.width, 80)))

    def bullet(self, text: str, indent: int = 2) -> None:
        print(" " * indent + self.bold_green("•") + " " + text)

    def kv(self, key: str, value: str, width: int | None = None) -> None:
        w = width or 24
        print(f"  {self.bold_yellow(key.ljust(w))} {self.bold_white(value)}")

    def badge(self, kind: str) -> str:
        badges = {
            "create": self.bold_green("+"),
            "delete": self.bold_red("−"),
            "edit": self.bold_yellow("✎"),
            "append": self.bold_cyan("~"),
            "symlink": self.bold_magenta("→"),
            "skip": self.dim("·"),
        }
        return badges.get(kind, "?")

    def box(self, lines: list[str]) -> None:
        w = max(len(l) for l in lines) + 4
        w = min(w, self.width - 2)
        top = self.bold_blue("╭" + "═" * (w - 2) + "╮")
        bot = self.bold_blue("╰" + "═" * (w - 2) + "╯")
        print(top)
        for l in lines:
            print("  " + l)
        print(bot)

    def pause(self, msg: str = "Press Enter to continue…") -> None:
        if self.auto or not sys.stdout.isatty():
            return
        try:
            input(f"\n{self.bold_yellow(msg)}")
        except (EOFError, KeyboardInterrupt):
            pass


# ANSI codes — full color palette
RED = "\x1b[31;1m"
GREEN = "\x1b[32;1m"
YELLOW = "\x1b[33;1m"
BLUE = "\x1b[34;1m"
MAGENTA = "\x1b[35;1m"
CYAN = "\x1b[36;1m"
WHITE = "\x1b[37;1m"

# Bright variants
BRIGHT_RED = "\x1b[91;1m"
BRIGHT_GREEN = "\x1b[92;1m"
BRIGHT_YELLOW = "\x1b[93;1m"
BRIGHT_BLUE = "\x1b[94;1m"
BRIGHT_MAGENTA = "\x1b[95;1m"
BRIGHT_CYAN = "\x1b[96;1m"
BRIGHT_WHITE = "\x1b[97;1m"

# Style modifiers
DIM = "\x1b[2m"
BOLD = "\x1b[1m"
ITALIC = "\x1b[3m"
UNDERLINE = "\x1b[4m"
BLINK = "\x1b[5m"
REVERSE = "\x1b[7m"
RESET = "\x1b[0m"

# Backgrounds (for emphasis)
BG_RED = "\x1b[41m"
BG_GREEN = "\x1b[42m"
BG_YELLOW = "\x1b[43m"
BG_BLUE = "\x1b[44m"

UI = UI()


# ---------------------------------------------------------------------------
# YAML line map (for error context)
# ---------------------------------------------------------------------------

def _yaml_line_map(text: str) -> dict[tuple, int]:
    """Map YAML paths to 1-based line numbers using yaml.compose()."""
    try:
        node = yaml.compose(text)
    except yaml.YAMLError:
        return {}

    lines: dict[tuple, int] = {}

    def walk(node, path):
        if isinstance(node, yaml.MappingNode):
            for k, v in node.value:
                p = path + (k.value,)
                lines[p] = k.start_mark.line + 1
                walk(v, p)
        elif isinstance(node, yaml.SequenceNode):
            for i, item in enumerate(node.value):
                p = path + (i,)
                lines[p] = item.start_mark.line + 1
                walk(item, p)
        else:
            lines[path] = node.start_mark.line + 1

    walk(node, ())
    return lines


def _build_error_context(text: str, line: int, column: int = 0) -> str:
    """Build a colored context block showing +/-2 lines around the error line."""
    lines = text.splitlines()
    total = len(lines)
    start = max(0, line - 3)
    end = min(total, line + 2)

    out_lines = []
    for i in range(start, end):
        num = i + 1
        if num == line:
            # Error line: bright red + underline, with > marker
            out_lines.append(
                f"  {UI.bold_red(f'>{num:4d}')} | {UI.bold_red(UI._wrap(lines[i], UNDERLINE))}"
            )
        else:
            # Context line: dim grey
            out_lines.append(f"  {UI.dim(f'{num:4d}')} | {UI.dim(lines[i])}")

    return "\n".join(out_lines)


class PatchValidationError(RuntimeError):
    """Validation error that preserves the original jsonschema error for location."""
    def __init__(self, msg: str, *, original: Exception | None = None):
        super().__init__(msg)
        self.original = original


def _locate_error(text: str, exc: Exception) -> tuple[int, int, str]:
    """Determine error location (line, column, path_label) from exception."""
    line_map = _yaml_line_map(text)

    # YAML syntax error
    if isinstance(exc, yaml.YAMLError):
        if hasattr(exc, "problem_mark"):
            mark = exc.problem_mark
            line = mark.line + 1
            col = mark.column + 1
            return line, col, f"line {line}, column {col}"

    # jsonschema validation error (possibly wrapped in PatchValidationError)
    if jsonschema:
        orig = getattr(exc, "original", exc)
        if isinstance(orig, jsonschema.ValidationError):
            best = best_match([orig]) if best_match else orig
            path = tuple(best.absolute_path)
            line_info = line_map.get(path)
            if isinstance(line_info, tuple):
                return line_info
            elif isinstance(line_info, int):
                return (line_info, 0, "unknown")
            # fallback: try to find column by scanning the line
            if line_info != 1 and line_info <= len(text.splitlines()):
                line_text = text.splitlines()[line_info - 1]
                last = path[-1] if path else ""
                if isinstance(last, str):
                    idx = line_text.find(last)
                    if idx >= 0:
                        return (line_info, idx + 1, "unknown")
            return (line_info if isinstance(line_info, int) else 1, 0, "unknown")

    # Manual meta.scope / meta.register errors
    for key in ("meta.scope", "meta.register"):
        if key in str(exc) or (exc.args and key in str(exc.args[0])):
            path_key = ("meta", "scope" if "scope" in key else "register")
            line_info = line_map.get(path_key)
            if isinstance(line_info, int):
                return (line_info, 0, key)
            return line_info if isinstance(line_info, tuple) else (1, 1, key)

    return 1, 0, "unknown"


def _report_file_block(patch_path: Path, errors: list[dict], warnings: list[dict]) -> None:
    """Print one file's validation block with box-drawing format."""
    has_errors = bool(errors)

    # File header
    if has_errors:
        print(f"  {UI.err(patch_path.name)}")
    else:
        print(f"  {UI.ok(patch_path.name)}")

    # Separator
    print(UI.bold_magenta("-" * 60))

    # Error context + messages
    if errors:
        first_err = errors[0]
        line = first_err.get("line", 1)
        text = ""
        try:
            text = patch_path.read_text()
        except OSError:
            pass

        print(f"  {UI.bold_white('error')} at {UI.bold_yellow(f'line {line}'):}")
        if text:
            print(_build_error_context(text, line))

        for e in errors:
            print(f"  {UI.bold_red('✦')} {UI.bold_red(e['msg'])}")

    # Warning messages
    for w in warnings:
        print(f"  {UI.bold_yellow('⚠')} {UI.bold_yellow(w['msg'])}")

    # Closing separator
    print(UI.bold_cyan("=" * 60))


# ---------------------------------------------------------------------------
# Schema validation & Nomenclature
# ---------------------------------------------------------------------------

SCHEMA_FILENAME = "schema.yaml"
BRANCH_PATCH_REGEX = re.compile(r"^00-[A-Z][A-Z0-9_]*\.yaml$")
VERSION_PATCH_REGEX = re.compile(
    r"^(\d+)\.(\d+)(?:\.([abr]))?(?:-(\d+))?(?:-([a-z0-9]+(?:_[a-z0-9]+)*))?\.yaml$"
)

_jsonschema_warned = False
_schema_validator_cache: dict[str, tuple] = {}


def _load_schema(patches_dir: Path) -> Path | None:
    schema_path = patches_dir / SCHEMA_FILENAME
    if schema_path.exists():
        return schema_path
    schema_path = DEFAULT_PATCHES_DIR / SCHEMA_FILENAME
    if schema_path.exists():
        return schema_path
    return None


def _get_schema_validator(schema_path: Path):
    cache_key = str(schema_path)
    if cache_key in _schema_validator_cache:
        return _schema_validator_cache[cache_key]

    try:
        schema = yaml.safe_load(schema_path.read_text())
    except Exception as e:
        raise RuntimeError(f"failed to load schema {schema_path}: {e}")

    validator = jsonschema.validators.validator_for(schema)(schema)
    _schema_validator_cache[cache_key] = (validator, schema)
    return validator, schema


def _validate_schema(patch: dict, patches_dir: Path, filename: str, validate_mode: bool):
    global _jsonschema_warned
    if jsonschema is None:
        if not _jsonschema_warned:
            print(UI.warn("jsonschema not installed — schema validation skipped (pacman -S python-jsonschema)"))
            _jsonschema_warned = True
        return

    schema_path = _load_schema(patches_dir)
    if schema_path is None:
        return

    try:
        schema = yaml.safe_load(schema_path.read_text())
    except Exception as e:
        if validate_mode:
            raise RuntimeError(f"failed to load schema {schema_path}: {e}")
        return

    try:
        validator, _ = _get_schema_validator(schema_path)
        validator.validate(patch)
    except jsonschema.ValidationError as e:
        raise PatchValidationError(
            f"schema validation failed: {e.message} (at {' -> '.join(map(str, e.absolute_path))})",
            original=e
        )


def _check_nomenclature(filename: str, validate_mode: bool) -> tuple[bool, str]:
    if BRANCH_PATCH_REGEX.match(filename):
        return True, ""
    if VERSION_PATCH_REGEX.match(filename):
        return True, ""
    msg = (f"filename '{filename}' does not match nomenclature: "
           f"expected '00-<BRANCH>.yaml' or '<major>.<minor>[.<type>][-<serial>][-<name>].yaml' "
           f"(type ∈ {{a,b,r}}, name snake_case)")
    if validate_mode:
        return False, msg
    print(UI.warn(msg))
    return True, msg


def _resolve_patches_dir(patches_dir: Path, validate_mode: bool) -> Path:
    if not patches_dir.is_dir():
        raise RuntimeError(f"patches dir not found: {patches_dir}")
    return patches_dir


# ---------------------------------------------------------------------------
# Validation entry point
# ---------------------------------------------------------------------------

def validate_patch_file(path: Path) -> tuple[list[dict], list[dict]]:
    """Validate a single patch file. Returns (errors, warnings).
    Each error/warning is a dict with: msg, line, col, path_label
    """
    errors = []
    warnings = []
    text = ""
    try:
        text = path.read_text()
        patch = yaml.safe_load(text)
        meta = (patch or {}).get("meta") or {}

        # meta.register (schema doesn't enforce boolean type strictly)
        register = meta.get("register", True)
        if not isinstance(register, bool):
            line, col, loc = _locate_error(text, RuntimeError("meta.register"))
            errors.append({"msg": f"meta.register must be boolean, got {register!r}", "line": line, "col": col, "loc": loc})

        # schema (validates meta.scope enum, etc.)
        if jsonschema:
            try:
                _validate_schema(patch, path.parent, path.name, True)
            except PatchValidationError as e:
                line, col, loc = _locate_error(text, e)
                errors.append({"msg": str(e), "line": line, "col": col, "loc": loc})

        # replace patterns
        for i, fop in enumerate(patch.get("files") or []):
            if fop.get("op") == "replace":
                try:
                    compile_pattern(fop["match"])
                except ValueError as e:
                    line, col, loc = _locate_error(text, RuntimeError(f"files[{i}].match"))
                    errors.append({"msg": f"files[{i}].match: {e}", "line": line, "col": col, "loc": loc})

        # nomenclature
        ok, msg = _check_nomenclature(path.name, True)
        if not ok:
            warnings.append({"msg": msg, "line": 1, "col": 0, "loc": "filename"})

    except Exception as e:
        line, col, loc = _locate_error(text, e)
        errors.append({"msg": str(e), "line": line, "col": col, "loc": loc})

    return errors, warnings


def run_validate(patches_dir: Path, explicit_files: list) -> int:
    """Validate patches. Returns 0 if all valid, 1 if any error."""
    patches_dir = _resolve_patches_dir(patches_dir, True)

    if explicit_files:
        files = [Path(f) for f in explicit_files]
    else:
        ignore_patterns = load_patchignore(patches_dir)
        files = sorted(patches_dir.glob("*.yaml"), key=lambda p: p.name)
        files = [f for f in files if not is_patch_ignored(f.name, ignore_patterns)]

    # Collect all results first
    results = []
    total_errors = 0
    total_warnings = 0
    for f in files:
        errs, warns = validate_patch_file(f)
        results.append((f, errs, warns))
        total_errors += len(errs)
        total_warnings += len(warns)

    # Print validation header
    print(UI.bold_blue("VALIDATION:"))
    print(UI.bold_cyan("=" * 60))

    # Print each file block
    for f, errs, warns in results:
        _report_file_block(f, errs, warns)

    # Print summary
    print(UI.bold_cyan("=" * 60))
    print(f"  {UI.bold_blue('SUMMARY')}")
    print(UI.bold_cyan("=" * 60))

    for f, errs, warns in results:
        if errs:
            print(f"  {UI.err(f.name)}")
        elif warns:
            print(f"  {UI.warn(f.name)}")
        else:
            print(f"  {UI.ok(f.name)}")

    if total_errors:
        return 1
    return 0


# ---------------------------------------------------------------------------
# Sudo bootstrap
# ---------------------------------------------------------------------------

def _ensure_sudo():
    if os.geteuid() == 0:
        return

    try:
        subprocess.run(["sudo", "-n", "true"], check=True, capture_output=True)
        script_path = Path(sys.argv[0]).resolve()
        os.execvp("sudo", ["sudo", str(script_path)] + sys.argv[1:])
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    print("n0ct-patch: requires root privileges", file=sys.stderr)
    try:
        subprocess.run(["sudo", "-v"], check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("n0ct-patch: sudo authentication failed", file=sys.stderr)
        sys.exit(1)

    script_path = Path(sys.argv[0]).resolve()
    os.execvp("sudo", ["sudo", str(script_path)] + sys.argv[1:])


# ---------------------------------------------------------------------------
# Constants & paths
# ---------------------------------------------------------------------------

DEFAULT_ROOT = Path("/usr/share/N0ctOS")
DEFAULT_PATCHES_DIR = DEFAULT_ROOT / "patches"
DEFAULT_PATCHIGNORE = ".patchignore"
SYSTEM_APPLIED_FILE = DEFAULT_ROOT / "local" / "patches-applied.txt"


def _invoking_user():
    import pwd

    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        try:
            pw = pwd.getpwnam(sudo_user)
            gid = int(os.environ.get("SUDO_GID", pw.pw_gid))
            return (pw.pw_name, pw.pw_uid, gid, Path(pw.pw_dir))
        except (KeyError, ValueError):
            pass
    sudo_uid = os.environ.get("SUDO_UID")
    if sudo_uid:
        try:
            uid = int(sudo_uid)
            if uid != 0:
                pw = pwd.getpwuid(uid)
                gid = int(os.environ.get("SUDO_GID", pw.pw_gid))
                return (pw.pw_name, uid, gid, Path(pw.pw_dir))
        except (ValueError, KeyError):
            pass
    return None


def _user_home() -> Path:
    inv = _invoking_user()
    if inv is not None:
        return inv[3]
    return Path.home()


def default_applied_file() -> Path:
    return _user_home() / ".config" / "N0ctOS" / "data" / "patches-applied.txt"


def system_applied_file() -> Path:
    return SYSTEM_APPLIED_FILE


def legacy_applied_file() -> Path:
    return _user_home() / ".config" / "N0ctOS" / "data" / "patches-applied.json"


def load_patchignore(patches_dir: Path) -> list[str]:
    ignore_file = patches_dir / DEFAULT_PATCHIGNORE
    if not ignore_file.exists():
        return []
    try:
        text = ignore_file.read_text()
    except OSError:
        return []
    patterns = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        patterns.append(line)
    return patterns


def is_patch_ignored(patch_name: str, ignore_patterns: list[str]) -> bool:
    for pattern in ignore_patterns:
        if fnmatch.fnmatch(patch_name, pattern):
            return True
    return False


LEGACY_APPLIED_FILE = Path.home() / ".config" / "N0ctOS" / "data" / "patches-applied.json"


def _chown_to_root(path: Path):
    if os.geteuid() != 0:
        return
    try:
        os.chown(path, 0, 0)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Package manager
# ---------------------------------------------------------------------------

def apply_packages(add, remove, dry_run: bool):
    add = list(add or [])
    remove = list(remove or [])

    if dry_run:
        if remove:
            print(UI.step(f"remove {' '.join(remove)}"))
            print(f"  run: {UI.bold_white('n0ct-pkg remove')} {' '.join(remove)}")
        if add:
            print(UI.step(f"add {' '.join(add)}"))
            print(f"  run: {UI.bold_white('n0ct-pkg add')} {' '.join(add)}")
        return

    if remove:
        print(UI.step(f"remove {' '.join(remove)}"))
        cmd = ["n0ct-pkg", "remove"] + remove
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as e:
            raise RuntimeError(f"package remove failed (exit {e.returncode})")
        print(UI.ok("remove — ok"))

    if add:
        print(UI.step(f"add {' '.join(add)}"))
        cmd = ["n0ct-pkg", "add"] + add
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as e:
            raise RuntimeError(f"package install failed (exit {e.returncode})")
        print(UI.ok("install — ok"))


def merge_packages(patches):
    state = {}
    for patch in patches:
        pkgs = patch.get("packages") or {}
        for p in pkgs.get("add") or []:
            state[str(p)] = "add"
        for p in pkgs.get("remove") or []:
            state[str(p)] = "remove"
    net_add = [p for p, s in state.items() if s == "add"]
    net_remove = [p for p, s in state.items() if s == "remove"]
    return net_add, net_remove


# ---------------------------------------------------------------------------
# Match language (with literal word-filter slots)
# ---------------------------------------------------------------------------

SLOT_SPAN_RE = re.compile(r"\{:(.*?):\}")


def compile_pattern(pattern: str) -> re.Pattern:
    r"""Compile a match-language string into a regex with one capture group.

    Slot bodies:
      - empty/whitespace-only   → builtin: any 1+ chars  (.+)
      - contains whitespace     → literal word filter  (escaped, \b boundaries)
      - no whitespace, known    → builtin: * .*  d \d+  s \s+
      - no whitespace, unknown  → error
    """
    # Extract slot span(s) first (they may contain spaces)
    slots = list(SLOT_SPAN_RE.finditer(pattern))
    if len(slots) != 1:
        raise ValueError(
            f"pattern must contain exactly one {{: :}} slot, found {len(slots)}: {pattern!r}"
        )

    slot_match = slots[0]
    raw_body = slot_match.group(1)
    placeholder = "\x00SLOT\x00"
    pattern_no_slot = pattern[:slot_match.start()] + placeholder + pattern[slot_match.end():]

    # Tokenize the rest on spaces
    tokens = pattern_no_slot.split(" ")
    parts = []
    slot_regex = ""

    for tok in tokens:
        if not tok:
            raise ValueError(f"empty token in pattern: {pattern!r}")

        if tok == placeholder:
            # Build slot regex from raw_body
            body = raw_body
            if body.strip() == "":
                # builtin: any 1+ chars
                slot_regex = r"(.+)"
            elif any(ch.isspace() for ch in body):
                # literal word filter
                literal = re.escape(body.strip())
                if literal and literal[0].isalnum() and literal[-1].isalnum():
                    literal = r"\b" + literal + r"\b"
                slot_regex = f"({literal})"
            else:
                # builtin lookup
                if body == "*":
                    slot_regex = r"(.*)"
                elif body == "d":
                    slot_regex = r"(\d+)"
                elif body == "s":
                    slot_regex = r"(\s+)"
                else:
                    raise ValueError(f"unknown slot body: {{{body}:}}")
            parts.append(slot_regex)
            continue

        if tok == "^+":
            parts.append(r".+?")
        elif tok == "^":
            parts.append(r".*?")
        elif tok == "_?":
            parts.append(r"\s*")
        elif tok == "_":
            parts.append(r"\s+")
        elif tok == "*":
            parts.append(r".")
        else:
            parts.append(re.escape(tok))

    return re.compile("".join(parts))


# ---------------------------------------------------------------------------
# Conditions
# ---------------------------------------------------------------------------

WHEN_TIMEOUT = 30


def _run_shell_capture(cmd: str, timeout: int):
    proc = subprocess.Popen(
        cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, stdin=subprocess.DEVNULL, preexec_fn=os.setpgrp,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        _kill_pgid(proc.pid)
        try:
            out, err = proc.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            out, err = "", ""
        raise subprocess.TimeoutExpired(cmd, timeout)
    except KeyboardInterrupt:
        _kill_pgid(proc.pid)
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            pass
        raise
    return proc.returncode, out, err


def _kill_pgid(pid: int):
    try:
        os.killpg(pid, 15)
    except OSError:
        pass


def check_when(when, dry_run: bool) -> bool:
    if when is None:
        return True
    cmds = when if isinstance(when, list) else [when]
    for cmd in cmds:
        try:
            returncode, _, _ = _run_shell_capture(cmd, WHEN_TIMEOUT)
        except subprocess.TimeoutExpired:
            print(UI.warn(f"{cmd!r} → timeout after {WHEN_TIMEOUT}s (fail)"))
            return False
        ok = returncode == 0
        if dry_run:
            print(f"    [when] {cmd!r} → {'pass' if ok else 'fail'}")
        if not ok:
            return False
    return True


# ---------------------------------------------------------------------------
# File operations
# ---------------------------------------------------------------------------

class ChangeLog:
    """Records what changed during a run for the result screen."""

    def __init__(self):
        self.patches: list[dict] = []       # {name, ok, error}
        self.files: list[dict] = []         # {path, kind, before, after}
        self.warnings: list[str] = []

    def add_patch(self, name: str, ok: bool, error: str | None = None):
        self.patches.append({"name": name, "ok": ok, "error": error})

    def add_file(self, path: str, kind: str, before: str | None = None, after: str | None = None):
        self.files.append({"path": path, "kind": kind, "before": before, "after": after})

    def add_warning(self, msg: str):
        self.warnings.append(msg)


CHANGELOG = ChangeLog()


def op_create(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    overwrite = spec.get("overwrite", False)
    content = spec.get("content", "")
    mode = spec.get("mode")

    if p.exists() and not overwrite:
        if dry_run:
            print(f"  {UI.bold_yellow('[create]')} {UI.bold_white(p)} — {UI.bold_yellow('EXISTS')} → {UI.bold_yellow('SKIP')}")
            return
        print(f"  {UI.bold_yellow('[create]')} {UI.bold_white(p)} — {UI.bold_yellow('EXISTS')} → {UI.bold_yellow('SKIP')}")
        return

    if dry_run:
        verb = "OVERWRITE" if p.exists() else "CREATE"
        print(f"  {UI.bold_yellow('[create]')} {UI.bold_white(p)} — {UI.bold_magenta(verb)}, {len(content)} bytes")
        if mode:
            print(f"         mode: {mode}")
        return

    p.parent.mkdir(parents=True, exist_ok=True)
    before = p.read_text() if p.exists() else None
    p.write_text(content)
    if mode:
        p.chmod(int(mode, 8))
    CHANGELOG.add_file(str(p), "create" if not before else "edit", before, content)
    print(UI.ok(f"wrote {p}"))


def op_delete(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    missing_ok = spec.get("missing_ok", True)

    if not p.exists():
        if missing_ok:
            print(f"  {UI.bold_red('[delete]')} {UI.bold_white(p)} — {UI.bold_green('already gone')} → SKIP")
            return
        raise RuntimeError(f"{p} does not exist")

    if dry_run:
        print(f"  {UI.bold_red('[delete]')} {UI.bold_white(p)} — {UI.bold_magenta('DELETE')} ({p.stat().st_size} bytes)")
        return

    before = p.read_text()
    p.unlink()
    CHANGELOG.add_file(str(p), "delete", before, None)
    print(UI.ok(f"removed {p}"))


def op_append(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    content = spec.get("content", "")
    newline_before = spec.get("newline_before", True)

    if not p.exists():
        if dry_run:
            print(f"  {UI.bold_cyan('[append]')} {UI.bold_white(p)} — {UI.bold_yellow('MISSING')} → SKIP")
            return
        print(f"  {UI.bold_cyan('[append]')} {UI.bold_white(p)} — {UI.bold_yellow('MISSING')} → SKIP")
        return

    existing = p.read_text()
    sep = ""
    if newline_before and existing and not existing.endswith("\n"):
        sep = "\n"

    if dry_run:
        preview = content.splitlines()[0] if content else ""
        print(f"  {UI.bold_cyan('[append]')} {UI.bold_white(p)} — {UI.bold_green('+')}{len(content)} bytes, first line: {preview!r}")
        return

    before = existing
    with p.open("a") as f:
        f.write(sep + content)
    CHANGELOG.add_file(str(p), "append", before, before + sep + content)
    print(UI.ok(f"appended to {p}"))


def op_replace(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    pattern = spec["match"]
    replacement = spec["replace"]

    if not p.exists():
        msg = f"target missing → SKIP"
        if dry_run:
            print(f"  {UI.bold_red('[replace]')} {UI.bold_white(p)}")
            print(f"          {UI.bold_yellow(msg)}")
            return
        print(UI.warn(f"{p}: {msg}"))
        CHANGELOG.add_warning(f"replace: {p}: target missing")
        return

    rx = compile_pattern(pattern)
    lines = p.read_text().splitlines(keepends=True)
    matches = []

    for i, line in enumerate(lines):
        m = rx.search(line.rstrip("\n"))
        if m:
            matches.append((i, m))

    if not matches:
        msg = f"no match in {p} for pattern {pattern!r}"
        if dry_run:
            print(f"  {UI.bold_red('[replace]')} {UI.bold_white(p)}")
            print(f"          pattern: {pattern!r}")
            print(f"          regex:   {rx.pattern}")
            print(f"          matches: {UI.bold_red('0')} → SKIP")
            return
        print(UI.warn(f"{p}: {msg}"))
        CHANGELOG.add_warning(f"replace: {p}: no match")
        return

    if dry_run:
        print(f"  {UI.bold_red('[replace]')} {UI.bold_white(p)}")
        print(f"          pattern: {pattern!r}")
        print(f"          regex:   {rx.pattern}")
        print(f"          matches: {UI.bold_green(len(matches))}")
        for i, m in matches:
            old = lines[i].rstrip("\n")
            new = rx.sub(
                lambda mm: mm.group(0)[:mm.start(1) - mm.start(0)]
                         + replacement
                         + mm.group(0)[mm.end(1) - mm.start(0):],
                old, count=1)
            print(f"          line {i + 1}: {old!r}")
            print(f"                 → {new!r}")
        return

    before_text = "".join(lines)
    for i, _ in matches:
        line = lines[i].rstrip("\n")
        new_line = rx.sub(
            lambda mm: mm.group(0)[:mm.start(1) - mm.start(0)]
                     + replacement
                     + mm.group(0)[mm.end(1) - mm.start(0):],
            line,
            count=1,
        )
        ending = "\n" if lines[i].endswith("\n") else ""
        lines[i] = new_line + ending

    p.write_text("".join(lines))
    after_text = "".join(lines)
    CHANGELOG.add_file(str(p), "edit", before_text, after_text)
    print(UI.ok(f"{p} — {len(matches)} line(s) updated"))


def op_symlink(spec: dict, dry_run: bool):
    source = spec["source"]
    target = Path(spec["target"])
    overwrite = spec.get("overwrite", False)

    if target.exists() or target.is_symlink():
        if not overwrite:
            if dry_run:
                print(f"  {UI.bold_magenta('[symlink]')} {UI.bold_white(target)} -> {UI.bold_white(source)} — {UI.bold_yellow('EXISTS')} → SKIP")
                return
            print(f"  {UI.bold_magenta('[symlink]')} {UI.bold_white(target)} -> {UI.bold_white(source)} — {UI.bold_yellow('already exists')} → skipping")
            return
        if dry_run:
            print(f"  {UI.bold_magenta('[symlink]')} {UI.bold_white(target)} -> {UI.bold_white(source)} — OVERWRITE")
            return
        if target.is_dir() and not target.is_symlink():
            shutil.rmtree(target)
        else:
            target.unlink()

    if dry_run:
        print(f"  {UI.bold_magenta('[symlink]')} {UI.bold_white(target)} -> {UI.bold_white(source)} — CREATE")
        return

    target.parent.mkdir(parents=True, exist_ok=True)
    source_path = Path(source)
    if not source_path.is_absolute():
        source_path = (target.parent / source_path).resolve()
    target.symlink_to(source_path)
    CHANGELOG.add_file(str(target), "symlink", None, str(source_path))
    print(UI.ok(f"{target} -> {source_path}"))


FILE_OPS = {
    "create": op_create,
    "delete": op_delete,
    "append": op_append,
    "replace": op_replace,
    "symlink": op_symlink,
}


def run_file_op(spec: dict, dry_run: bool):
    op = spec.get("op")
    if op not in FILE_OPS:
        raise ValueError(f"unknown file op: {op!r}")
    FILE_OPS[op](spec, dry_run)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def run_command(cmd: dict, dry_run: bool):
    cid = cmd["id"]
    run = cmd["run"]
    timeout = cmd.get("timeout", 300)

    if dry_run:
        first = run.strip().splitlines()[0] if run.strip() else ""
        print(UI.step(f"{UI.bold_white(cid)} — would run: {UI.bold_yellow(first)}"))
        return

    try:
        returncode, _, stderr = _run_shell_capture(run, timeout)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"command {cid!r} timed out after {timeout}s (killed)")
    except KeyboardInterrupt:
        print(f"\n[UI.killed] command {cid!r} — interrupted, child killed", file=sys.stderr)
        raise
    if returncode != 0:
        raise RuntimeError(f"command {cid!r} failed (exit {returncode})\nstderr: {stderr.strip()}")
    print(UI.ok(f"{UI.bold_white(cid)} — ok"))


# ---------------------------------------------------------------------------
# Single patch
# ---------------------------------------------------------------------------

def run_section(name: str, items, runner, dry_run: bool):
    if not items:
        return
    UI.section(name)
    for item in items:
        if not check_when(item.get("when"), dry_run):
            label = item.get("id") or item.get("path") or "?"
            print(UI.skip(f"{label} — when condition failed"))
            continue
        runner(item, dry_run)


# ---------------------------------------------------------------------------
# Patch cache
# ---------------------------------------------------------------------------

_patch_cache: dict[str, dict] = {}


def _get_cached_patch(patch_path: Path, validate_mode: bool):
    key = (str(patch_path), validate_mode)
    if key in _patch_cache:
        return _patch_cache[key]
    patch = load_patch(patch_path, validate_mode)
    _patch_cache[key] = patch
    return patch


def _clear_patch_cache():
    global _patch_cache
    _patch_cache.clear()


def _safe_load_patch(patch_path: Path, validate_mode: bool = False):
    try:
        return load_patch(patch_path, validate_mode)
    except Exception:
        return None


def load_patch(patch_path: Path, validate_mode: bool = False):
    """Load + validate one patch YAML. Returns the patch dict."""
    patch = yaml.safe_load(Path(patch_path).read_text())
    meta = (patch or {}).get("meta") or {}

    scope = meta.get("scope")
    if scope not in ("system", "local"):
        raise RuntimeError(f"{patch_path}: meta.scope must be 'system' or 'local', got {scope!r}")

    register = meta.get("register", True)
    if not isinstance(register, bool):
        raise RuntimeError(f"{patch_path}: meta.register must be boolean (true/false), got {register!r}")

    patches_dir = patch_path.parent
    _validate_schema(patch, patches_dir, patch_path.name, validate_mode)

    return patch


def print_patch_header(patch, dry_run: bool):
    meta = patch.get("meta") or {}
    print(UI.step(f"{UI.bold_white(meta.get('name', 'unnamed'))}"))
    if meta.get("summary"):
        print(f"  {UI.bold_magenta(meta['summary'])}")
    if dry_run:
        print(UI.note("[DRY RUN]"))


def apply_file_phases(patch, dry_run: bool, with_packages: bool, with_pre: bool = True):
    if with_pre:
        run_section("pre", patch.get("pre") or [], run_command, dry_run)

    if with_packages:
        pkgs = patch.get("packages") or {}
        if pkgs.get("add") or pkgs.get("remove"):
            UI.section("packages")
            apply_packages(pkgs.get("add"), pkgs.get("remove"), dry_run)

    run_section("files", patch.get("files") or [], run_file_op, dry_run)
    run_section("commands", patch.get("commands") or [], run_command, dry_run)
    run_section("post", patch.get("post") or [], run_command, dry_run)


def apply_single_patch(patch_path: Path, dry_run: bool):
    patch = load_patch(patch_path, validate_mode=False)
    scope = patch.get("meta", {}).get("scope")
    print_patch_header(patch, dry_run)
    if scope:
        print(f"  {UI.bold_yellow('scope:')} {UI.bold_cyan(scope)}")
    apply_file_phases(patch, dry_run, with_packages=True, with_pre=True)


# ---------------------------------------------------------------------------
# Applied tracking
# ---------------------------------------------------------------------------

def load_applied(path: Path):
    p = Path(path)
    if not p.exists():
        legacy = p.with_suffix(".json")
        if p.suffix == ".txt" and legacy.exists():
            p = legacy
        elif p == default_applied_file():
            dyn_legacy = legacy_applied_file()
            if dyn_legacy.exists():
                p = dyn_legacy
            elif LEGACY_APPLIED_FILE.exists():
                p = LEGACY_APPLIED_FILE
            else:
                return []
        else:
            return []
        if not p.exists():
            return []

    try:
        text = p.read_text()
    except OSError as e:
        raise RuntimeError(f"cannot read {p}: {e} (check permissions)")

    stripped = text.strip()
    if stripped.startswith("["):
        try:
            data = json.loads(text)
        except json.JSONDecodeError as e:
            raise RuntimeError(f"cannot parse {p} as JSON: {e}")
        if not isinstance(data, list):
            raise RuntimeError(f"applied file {p} must be a list or line-per-file")
        names = []
        for entry in data:
            s = str(entry).strip()
            if s and not s.startswith("#"):
                names.append(s)
        return names

    names = []
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        names.append(s)
    return names


def save_applied(path: Path, names):
    p = Path(path)
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        try:
            p.parent.chmod(0o755)
        except OSError:
            pass
        _chown_to_root(p.parent)
        tmp = p.with_name(p.name + ".tmp")
        body = "".join(n + "\n" for n in names)
        tmp.write_text(body)
        _chown_to_root(tmp)
        tmp.replace(p)
        _chown_to_root(p)
        try:
            p.chmod(0o444)
        except OSError:
            pass
    except OSError as e:
        raise RuntimeError(f"cannot write {p}: {e} (run with sudo?)")


# ---------------------------------------------------------------------------
# Batch mode
# ---------------------------------------------------------------------------

def _load_applied_system(path: Path):
    return load_applied(path)


def _load_applied_local(path: Path):
    return load_applied(path)


def _save_applied_system(path: Path, names):
    save_applied(path, names)


def _save_applied_local(path: Path, names):
    save_applied(path, names)


def select_patches(patches_dir: Path, applied_system, applied_local, select_all: bool, ignore_patterns: list[str] = None):
    ignore_patterns = ignore_patterns or []
    d = Path(patches_dir)
    if not d.is_dir():
        raise RuntimeError(f"patches dir not found: {d}")
    all_paths = sorted(d.glob("*.yaml"), key=lambda p: p.name)
    filtered_paths = [p for p in all_paths if not is_patch_ignored(p.name, ignore_patterns)]

    system_patches = []
    local_patches = []
    for p in filtered_paths:
        patch = load_patch(p)
        scope = patch.get("meta", {}).get("scope")
        if scope == "system":
            system_patches.append(p)
        elif scope == "local":
            local_patches.append(p)
        else:
            raise RuntimeError(f"{p}: invalid scope {scope!r}")

    if select_all:
        return filtered_paths, system_patches, local_patches

    applied_system_set = set(applied_system)
    applied_local_set = set(applied_local)

    selected_system = [p for p in system_patches if p.name not in applied_system_set]
    selected_local = [p for p in local_patches if p.name not in applied_local_set]

    return filtered_paths, selected_system, selected_local


def run_check(patches_dir: Path, applied_system_file: Path, applied_local_file: Path, dry_run: bool) -> int:
    """Validate patches and list pending. Returns 0 if all valid and no pending, 1 if any problem."""
    if not patches_dir.is_dir():
        print(UI.err(f"patches dir not found: {patches_dir}"))
        return 1

    ignore_patterns = load_patchignore(patches_dir)
    # Don't filter branch patches (00-*.yaml) in check mode - we want to see them
    check_ignore_patterns = [p for p in ignore_patterns if p != "00-*.yaml"]

    all_paths = sorted(patches_dir.glob("*.yaml"), key=lambda p: p.name)
    all_paths = [f for f in all_paths if not is_patch_ignored(f.name, check_ignore_patterns)]

    if not all_paths:
        print(UI.info(f"no patches in {patches_dir}"))
        return 0

    # Collect all validation results (same format as --validate)
    results = []
    total_errors = 0
    total_warnings = 0
    valid_patches: dict[Path, dict] = {}
    for f in all_paths:
        errs, warns = validate_patch_file(f)
        results.append((f, errs, warns))
        total_errors += len(errs)
        total_warnings += len(warns)
        if not errs:
            try:
                valid_patches[f] = yaml.safe_load(f.read_text())
            except Exception:
                pass

    # Print validation header and file blocks (same format as --validate)
    print(UI.bold_blue("VALIDATION:"))
    print(UI.bold_cyan("=" * 60))
    for f, errs, warns in results:
        _report_file_block(f, errs, warns)

    # Print validation summary
    print(UI.bold_cyan("=" * 60))
    print(f"  {UI.bold_blue('SUMMARY')}")
    print(UI.bold_cyan("=" * 60))
    for f, errs, warns in results:
        if errs:
            print(f"  {UI.err(f.name)}")
        elif warns:
            print(f"  {UI.warn(f.name)}")
        else:
            print(f"  {UI.ok(f.name)}")

    # Pending patches section
    applied_system = _load_applied_system(applied_system_file)
    applied_local = _load_applied_local(applied_local_file)
    applied_system_set = set(applied_system)
    applied_local_set = set(applied_local)

    # Partition valid patches by scope
    system_patches = []
    local_patches = []
    for path, patch in valid_patches.items():
        scope = patch.get("meta", {}).get("scope")
        if scope == "system":
            system_patches.append(path)
        elif scope == "local":
            local_patches.append(path)

    # Pending = register:true and not yet applied
    selected_system = [
        p for p in system_patches
        if p.name not in applied_system_set and valid_patches[p].get("meta", {}).get("register", True)
    ]
    selected_local = [
        p for p in local_patches
        if p.name not in applied_local_set and valid_patches[p].get("meta", {}).get("register", True)
    ]

    print()
    print(UI.bold_magenta("PENDING:"))
    print(UI.bold_cyan("=" * 60))

    has_pending = False

    if selected_system:
        has_pending = True
        print(f"  {UI.bold_green('Pending system patches:')}")
        for path in selected_system:
            patch = valid_patches[path]
            meta = patch.get("meta") or {}
            name = meta.get("name", "")
            summary = meta.get("summary", "")
            line = f"    {UI.bold_white(path.name)}"
            if name:
                line += f"  {UI.bold_yellow(f'({name}')}"
            reg = meta.get("register", True)
            line += f", {UI.bold_cyan(f'register={reg}')})"
            if summary:
                line += f" — {UI.bold_magenta(summary)}"
            print(line)

    if selected_local:
        has_pending = True
        print(f"  {UI.bold_green('Pending local patches:')}")
        for path in selected_local:
            patch = valid_patches[path]
            meta = patch.get("meta") or {}
            name = meta.get("name", "")
            summary = meta.get("summary", "")
            line = f"    {UI.bold_white(path.name)}"
            if name:
                line += f"  {UI.bold_yellow(f'({name}')}"
            reg = meta.get("register", True)
            line += f", {UI.bold_cyan(f'register={reg}')})"
            if summary:
                line += f" — {UI.bold_magenta(summary)}"
            print(line)

    if not has_pending:
        print(f"  {UI.ok('No pending patches.')}")

    if total_errors or has_pending:
        return 1
    return 0


# ---------------------------------------------------------------------------
# Summary screens
# ---------------------------------------------------------------------------

def show_plan_screen(patches_dir: Path, selected_system: list, selected_local: list,
                     applied_system: list, applied_local: list,
                     ignore_patterns: list[str]):
    """Pre-execution plan (verbose only)."""
    UI.title("Plan", f"{len(selected_system) + len(selected_local)} patches selected")

    if selected_system:
        UI.section("system patches")
        for path in selected_system:
            patch = load_patch(path, True)
            meta = patch.get("meta") or {}
            name = meta.get("name", "")
            summary = meta.get("summary", "")
            UI.bullet(f"{path.name} {UI.dim(f'({name})') if name else ''} — {summary or '—'}")

    if selected_local:
        UI.section("local patches")
        for path in selected_local:
            patch = load_patch(path, True)
            meta = patch.get("meta") or {}
            name = meta.get("name", "")
            summary = meta.get("summary", "")
            UI.bullet(f"{path.name} {UI.dim(f'({name})') if name else ''} — {summary or '—'}")

    # Files affected
    all_files = set()
    for path in selected_system + selected_local:
        patch = load_patch(path, True)
        for fop in patch.get("files") or []:
            all_files.add((fop.get("op"), fop.get("path")))

    if all_files:
        UI.section("files affected")
        for op, path in sorted(all_files):
            badge_kind = "edit" if op == "replace" else op
            badge = UI.badge(badge_kind)
            print(f"    {badge}  {path}")

    # Packages
    net_add, net_remove = merge_packages([
        load_patch(p, True) for p in selected_system + selected_local
    ])
    if net_add or net_remove:
        UI.section("packages")
        if net_remove:
            UI.bullet(f"remove: {' '.join(net_remove)}")
        if net_add:
            UI.bullet(f"add:    {' '.join(net_add)}")

    # Warnings (collected during validation)
    if CHANGELOG.warnings:
        UI.section("warnings")
        for w in CHANGELOG.warnings:
            print(f"    {UI.warn(w)}")

    UI.rule()
    UI.pause()


def show_result_screen():
    """Post-execution result screen (always)."""
    UI.title("Result")

    if CHANGELOG.patches:
        UI.section("patches")
        for p in CHANGELOG.patches:
            if p["ok"]:
                print(f"    {UI.ok(p['name'])}")
            else:
                print(f"    {UI.err(p['name'])}")

    if CHANGELOG.files:
        UI.section("files")
        for f in CHANGELOG.files:
            badge = UI.badge(f["kind"])
            print(f"    {badge}  {UI.bold_white(f['path'])}")

    if CHANGELOG.warnings:
        UI.section("warnings")
        for w in CHANGELOG.warnings:
            print(f"    {UI.warn(w)}")

    if UI.verbose and CHANGELOG.files:
        UI.section("diffs (verbose)")
        for f in CHANGELOG.files:
            if f["kind"] in ("edit", "append") and f["before"] is not None and f["after"] is not None:
                print(f"\n  {UI.bold_magenta(f['path'])}")
                diff = difflib.unified_diff(
                    f["before"].splitlines(keepends=True),
                    f["after"].splitlines(keepends=True),
                    fromfile="before", tofile="after", lineterm=""
                )
                for line in diff:
                    if line.startswith("---") or line.startswith("+++"):
                        print(f"    {UI.bold_yellow(line)}")
                    elif line.startswith("-"):
                        print(f"    {UI.bold_red(line)}")
                    elif line.startswith("+"):
                        print(f"    {UI.bold_green(line)}")
                    else:
                        print(f"    {UI.dim(line)}")

    UI.rule()
    UI.pause()


# ---------------------------------------------------------------------------
# apply_batch
# ---------------------------------------------------------------------------

def apply_batch(patches_dir: Path, applied_system_file: Path, applied_local_file: Path, dry_run: bool,
                select_all: bool, check_mode: bool = False):
    global CHANGELOG
    CHANGELOG = ChangeLog()

    ignore_patterns = load_patchignore(patches_dir)
    all_paths, selected_system, selected_local = select_patches(
        patches_dir,
        _load_applied_system(applied_system_file),
        _load_applied_local(applied_local_file),
        select_all, ignore_patterns
    )
    if not all_paths:
        print(UI.info(f"no patches in {patches_dir}"))
        return

    applied_system = _load_applied_system(applied_system_file)
    applied_local = _load_applied_local(applied_local_file)
    applied_system_set = set(applied_system)
    applied_local_set = set(applied_local)

    mode = "all" if select_all else "diff"
    total_system = len([p for p in all_paths if load_patch(p, False).get("meta", {}).get("scope") == "system"])
    total_local = len([p for p in all_paths if load_patch(p, False).get("meta", {}).get("scope") == "local"])

    UI.section("batch")
    UI.kv("patches dir", str(patches_dir))
    UI.kv("mode", f"{mode} ({len(selected_system)} system + {len(selected_local)} local selected, {total_system} sys + {total_local} local total)")
    UI.kv("system applied", f"{applied_system_file} ({len(applied_system)} applied)")
    UI.kv("local applied", f"{applied_local_file} ({len(applied_local)} applied)")
    if ignore_patterns:
        UI.kv("ignored", ", ".join(ignore_patterns))
    if dry_run:
        print(UI.note("[DRY RUN — will not register]"))

    if not select_all:
        for p in all_paths:
            patch = load_patch(p, False)
            scope = patch.get("meta", {}).get("scope")
            if scope == "system" and p.name in applied_system_set:
                print(UI.skip(f"{p.name} — already applied (system)"))
            elif scope == "local" and p.name in applied_local_set:
                print(UI.skip(f"{p.name} — already applied (local)"))

    if not selected_system and not selected_local:
        print(UI.ok("nothing to do."))
        return

        # VALIDATE ALL SELECTED PATCHES UP FRONT
    validation_errors = []
    for path in selected_system + selected_local:
        errs, warns = validate_patch_file(path)
        for e in errs:
            validation_errors.append((path, e))
        for w in warns:
            CHANGELOG.add_warning(f"{path.name}: {w['msg']}")

    if validation_errors:
        print(UI.err("Validation failed before execution:"))
        for path, err in validation_errors:
            _report_file_error(path, RuntimeError(err), False)
        sys.exit(2)

    # Plan screen (verbose only)
    if UI.verbose:
        show_plan_screen(patches_dir, selected_system, selected_local,
                         applied_system, applied_local, ignore_patterns)

    # Load all selected patches for package merging
    loaded_system = [(p, load_patch(p, False)) for p in selected_system]
    loaded_local = [(p, load_patch(p, False)) for p in selected_local]
    all_loaded = loaded_system + loaded_local

    # 1. pres upfront, file order (all patches)
    for path, patch in all_loaded:
        if patch.get("pre"):
            UI.section(f"pre: {path.name}")
            run_section("pre", patch.get("pre") or [], run_command, dry_run)

    # 2. merged packages across ALL selected patches (system + local), once
    net_add, net_remove = merge_packages([patch for _, patch in all_loaded])
    if net_add or net_remove:
        UI.section("packages (merged)")
        UI.bullet(f"from: {', '.join(p.name for p, _ in all_loaded)}")
        if net_remove:
            UI.bullet(f"remove: {' '.join(net_remove)}")
        if net_add:
            UI.bullet(f"add:    {' '.join(net_add)}")
        apply_packages(net_add, net_remove, dry_run)
    else:
        UI.section("packages (merged)")
        print(UI.note("nothing to do"))

    # 3. Apply system patches first
    if loaded_system:
        UI.section("system patches")
    for path, patch in loaded_system:
        name = path.name
        UI.section(name)
        print_patch_header(patch, dry_run)
        run_section("files", patch.get("files") or [], run_file_op, dry_run)
        run_section("commands", patch.get("commands") or [], run_command, dry_run)
        run_section("post", patch.get("post") or [], run_command, dry_run)

        register = patch.get("meta", {}).get("register", True)
        if dry_run:
            if register:
                print(UI.note(f"[dry-run] would register {name} (system, register={register})"))
        elif register:
            if name in applied_system_set:
                print(UI.skip(f"{name} — already listed (system)"))
            else:
                applied_system.append(name)
                applied_system_set.add(name)
                _save_applied_system(applied_system_file, applied_system)
                print(UI.ok(f"registered {name} (system)"))
                CHANGELOG.add_patch(name, True)
        else:
            print(UI.skip(f"{name} (register=false)"))
            CHANGELOG.add_patch(name, True, "register=false")

    # 4. Apply local patches second
    if loaded_local:
        UI.section("local patches")
    for path, patch in loaded_local:
        name = path.name
        UI.section(name)
        print_patch_header(patch, dry_run)
        run_section("files", patch.get("files") or [], run_file_op, dry_run)
        run_section("commands", patch.get("commands") or [], run_command, dry_run)
        run_section("post", patch.get("post") or [], run_command, dry_run)

        register = patch.get("meta", {}).get("register", True)
        if dry_run:
            if register:
                print(UI.note(f"[dry-run] would register {name} (local, register={register})"))
        elif register:
            if name in applied_local_set:
                print(UI.skip(f"{name} — already listed (local)"))
            else:
                applied_local.append(name)
                applied_local_set.add(name)
                _save_applied_local(applied_local_file, applied_local)
                print(UI.ok(f"registered {name} (local)"))
                CHANGELOG.add_patch(name, True)
        else:
            print(UI.skip(f"{name} (register=false)"))
            CHANGELOG.add_patch(name, True, "register=false")

    # Result screen (always, unless --auto)
    if not UI.auto:
        show_result_screen()

    print(UI.ok("done."))


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description="Apply patch YAML files to the system.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Modes:
  n0ct-patch                          # scan default dir, apply missing (default)
  n0ct-patch -m                       # apply unapplied patches from default dir
  n0ct-patch -a                       # apply all patches from default dir
  n0ct-patch -d /path/to/patches      # scan custom directory
  n0ct-patch patch1.yaml patch2.yaml  # apply explicit files (ignores .patchignore)
  n0ct-patch -c                       # validate + list pending patches (exit 0/1)
  n0ct-patch -c -d /path              # check custom directory
  n0ct-patch --validate               # validate only, no execution
  n0ct-patch -V                       # verbose output with plan + diffs
  n0ct-patch --auto                   # non-interactive, script-friendly
"""
    )
    ap.add_argument("patches", nargs="*", help="explicit patch YAML files to apply")
    ap.add_argument("-n", "--dry-run", action="store_true", help="preview changes without applying")
    ap.add_argument("-c", "--check", action="store_true", help="validate + list pending patches (exit 0=clean, 1=problem)")
    ap.add_argument("-v", "--validate", action="store_true", help="validate patch schema and nomenclature (exit 0=all valid, 1=any error)")
    ap.add_argument("-V", "--verbose", action="store_true", help="verbose output: plan screen, diffs, extra detail")
    ap.add_argument("-m", "--apply-missing", action="store_true", help="batch: apply unapplied patches from --patches-dir (default if no args)")
    ap.add_argument("-a", "--all", action="store_true", help="batch: apply every patch, ignore applied file (still registers)")
    ap.add_argument("-p", "--patches-dir", default=str(DEFAULT_PATCHES_DIR), help="directory to scan for patches (default: %(default)s)")
    ap.add_argument("-d", "--dir", dest="custom_dir", metavar="DIR", help="alias for --patches-dir")
    ap.add_argument("-s", "--system-file", default=str(system_applied_file()), help="system-wide applied list (default: %(default)s)")
    ap.add_argument("-l", "--local-file", default=str(default_applied_file()), help="user-local applied list (default: %(default)s)")
    ap.add_argument("--applied-file", dest="applied_file_legacy", default=None, help=argparse.SUPPRESS)
    ap.add_argument("--no-root-check", action="store_true", help="testing only: allow real runs without root")
    ap.add_argument("--auto", action="store_true", help="non-interactive, script-friendly (no prompts, no colors, no screens)")
    ap.add_argument("--color", choices=["auto", "always", "never"], default="auto", help="ANSI color mode (default: auto)")

    args = ap.parse_args()

    # Configure UI
    UI.configure(color=args.color, verbose=args.verbose, auto=args.auto)

    # Handle legacy --applied-file alias
    applied_local_file = Path(args.local_file)
    if args.applied_file_legacy is not None:
        applied_local_file = Path(args.applied_file_legacy)
    applied_system_file = Path(args.system_file)

    # Handle --dir alias
    patches_dir = Path(args.custom_dir) if args.custom_dir else Path(args.patches_dir)

    # Mutually exclusive mode checks
    has_explicit_files = len(args.patches) > 0
    is_batch_mode = args.apply_missing or args.all

    # Default to --apply-missing if no explicit files, no --all, no --check, no --validate
    if not has_explicit_files and not args.all and not args.check and not args.validate and not args.apply_missing:
        is_batch_mode = True
        args.apply_missing = True

    if has_explicit_files and is_batch_mode:
        ap.error("explicit patch files cannot be combined with --apply-missing/--all")
    if has_explicit_files and args.custom_dir:
        ap.error("explicit patch files cannot be combined with --dir/--patches-dir")
    if args.check and has_explicit_files:
        ap.error("--check cannot be used with explicit patch files")

    # Read-only modes don't need sudo
    is_read_only = args.dry_run or args.check or args.validate
    if not is_read_only and not args.no_root_check:
        _ensure_sudo()

    try:
        if args.check:
            exit_code = run_check(patches_dir, applied_system_file, applied_local_file, args.dry_run)
            sys.exit(exit_code)

        if args.validate:
            exit_code = run_validate(patches_dir, args.patches)
            sys.exit(exit_code)

        if has_explicit_files:
            for patch_file in args.patches:
                apply_single_patch(Path(patch_file), args.dry_run)
            if not args.dry_run:
                print(UI.ok("done."))
        else:
            apply_batch(patches_dir, applied_system_file, applied_local_file, args.dry_run,
                        select_all=args.all, check_mode=False)
    except KeyboardInterrupt:
        print("\n" + UI.dim("interrupted — nothing registered beyond last [register]"), file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
        print(f"\n{UI.err(str(e))}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"\n{UI.err(f'{type(e).__name__}: {e}')}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()