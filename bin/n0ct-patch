#!/usr/bin/env python3
"""
patcher.py — applies a YAML patch file to the local system.

Usage:
    patcher.py patch.yaml [--dry-run]
    patcher.py --apply-missing [--patches-dir DIR] [--applied-file FILE] [--dry-run]
    patcher.py --all [--patches-dir DIR] [--applied-file FILE] [--dry-run]

Single-patch mode applies one YAML file: pre → pkgs → files → commands → post.

Batch modes scan a patches dir in filename order:
  --apply-missing  only patches not yet listed in the applied file (diff)
  --all            every *.yaml, ignoring the applied file (still registers)

Batch order:
  1. all `pre` blocks, file order
  2. merged packages: last-op-wins per package, remove then install, once
  3. per file in order: files → commands → post, registering each on success
"""

import argparse
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

import yaml

try:
    import jsonschema
except ImportError:
    jsonschema = None


def _ensure_sudo():
    """Ensure we're running as root, prompting for sudo if needed.

    Similar to n0ct-pkg's check_sudo(): if not root, validate sudo access
    and re-execute with sudo. Exits on failure.
    """
    if os.geteuid() == 0:
        return

    # Check if we have passwordless sudo
    try:
        subprocess.run(["sudo", "-n", "true"], check=True, capture_output=True)
        # Have passwordless sudo, re-execute with sudo
        os.execvp("sudo", ["sudo", sys.argv[0]] + sys.argv[1:])
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    # Need to prompt for password
    print("n0ct-patch: requires root privileges", file=sys.stderr)
    try:
        subprocess.run(["sudo", "-v"], check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("n0ct-patch: sudo authentication failed", file=sys.stderr)
        sys.exit(1)

    # Re-execute with sudo
    os.execvp("sudo", ["sudo", sys.argv[0]] + sys.argv[1:])


# Re-execute with sudo
    os.execvp("sudo", ["sudo", sys.argv[0]] + sys.argv[1:])


# ---------------------------------------------------------------------------
# Schema validation & Nomenclature
# ---------------------------------------------------------------------------

SCHEMA_FILENAME = "schema.yaml"
BRANCH_PATCH_REGEX = re.compile(r"^00-[A-Z][A-Z0-9_]*\.yaml$")
# Version patch: major.minor[.type][-serial][-name].yaml
# type ∈ {a,b,r} optional; serial optional; name optional (snake_case)
VERSION_PATCH_REGEX = re.compile(
    r"^(\d+)\.(\d+)(?:\.([abr]))?(?:-(\d+))?(?:-([a-z0-9]+(?:_[a-z0-9]+)*))?\.yaml$"
)

_jsonschema_warned = False


def _load_schema(patches_dir: Path):
    """Load JSON schema from patches dir or default location."""
    # Try patch's directory first
    schema_path = patches_dir / SCHEMA_FILENAME
    if schema_path.exists():
        return schema_path
    # Try default patches dir
    schema_path = DEFAULT_PATCHES_DIR / SCHEMA_FILENAME
    if schema_path.exists():
        return schema_path
    return None


def _validate_schema(patch: dict, patches_dir: Path, filename: str, validate_mode: bool):
    """Validate patch against JSON schema. Raises RuntimeError on failure."""
    global _jsonschema_warned
    if jsonschema is None:
        if not _jsonschema_warned:
            print("  [warn] jsonschema not installed — schema validation skipped (pacman -S python-jsonschema)", file=sys.stderr)
            _jsonschema_warned = True
        return

    schema_path = _load_schema(patches_dir)
    if schema_path is None:
        return  # no schema, skip silently

    try:
        schema = yaml.safe_load(schema_path.read_text())
    except Exception as e:
        if validate_mode:
            raise RuntimeError(f"failed to load schema {schema_path}: {e}")
        return

    try:
        jsonschema.validate(instance=patch, schema=schema)
    except jsonschema.ValidationError as e:
        # Use best match for clearer error
        best = e
        while best.context:
            best = best.context[0]
        msg = f"schema validation failed: {best.message} (at {' -> '.join(map(str, best.absolute_path))})"
        raise RuntimeError(msg)


def _check_nomenclature(filename: str, validate_mode: bool):
    """Check patch filename against nomenclature. Returns (is_valid, message)."""
    if BRANCH_PATCH_REGEX.match(filename):
        return True, ""
    if VERSION_PATCH_REGEX.match(filename):
        return True, ""
    msg = (f"filename '{filename}' does not match nomenclature: "
           f"expected '00-<BRANCH>.yaml' or '<major>.<minor>[.<type>][-<serial>][-<name>].yaml' "
           f"(type ∈ {{a,b,r}}, name snake_case)")
    if validate_mode:
        return False, msg
    print(f"  [warn] {msg}", file=sys.stderr)
    return True, msg


def _resolve_patches_dir(patches_dir: Path, validate_mode: bool):
    """Resolve patches directory, checking existence."""
    if not patches_dir.is_dir():
        raise RuntimeError(f"patches dir not found: {patches_dir}")
    return patches_dir


def run_validate(patches_dir: Path, explicit_files: list):
    """Validate patches. Returns 0 if all valid, 1 if any error."""
    patches_dir = _resolve_patches_dir(patches_dir, True)
    errors = 0
    warnings = 0

    if explicit_files:
        files = [Path(f) for f in explicit_files]
    else:
        # In validation mode, check all patches but respect .patchignore
        ignore_patterns = load_patchignore(patches_dir)
        files = sorted(patches_dir.glob("*.yaml"), key=lambda p: p.name)
        files = [f for f in files if not is_patch_ignored(f.name, ignore_patterns)]

    for f in files:
        try:
            patch = load_patch(f)
            # Schema validation
            _validate_schema(patch, patches_dir, f.name, True)
            # Nomenclature check
            ok, msg = _check_nomenclature(f.name, True)
            if not ok:
                print(f"ERROR {f.name}: {msg}")
                errors += 1
            else:
                print(f"OK {f.name}")
        except Exception as e:
            print(f"ERROR {f.name}: {e}")
            errors += 1

    if errors:
        print(f"\nValidation failed: {errors} error(s), {warnings} warning(s)")
        return 1
    print(f"\nAll {len(files)} patch(es) valid.")
    return 0
#
# Root is always /usr/share/N0ctOS on a deployed system. Patches live in
# <root>/patches. The applied list lives in the user config dir.

DEFAULT_ROOT = Path("/usr/share/N0ctOS")
DEFAULT_PATCHES_DIR = DEFAULT_ROOT / "patches"
DEFAULT_PATCHIGNORE = ".patchignore"
SYSTEM_APPLIED_FILE = DEFAULT_ROOT / "local" / "patches-applied.txt"


def _invoking_user():
    """Return (name, uid, gid, home) for the user behind sudo, else None.

    When n0ct-patch runs via sudo, Path.home()/HOME point at /root.
    The applied file must live in the local user's home, not root's.
    Ownership stays root (see save_applied) — this helper is only for
    path resolution and for dropping paru privileges, never for chown.
    """
    import pwd

    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        try:
            pw = pwd.getpwnam(sudo_user)
            gid = int(os.environ.get("SUDO_GID", pw.pw_gid))
            return (pw.pw_name, pw.pw_uid, gid, Path(pw.pw_dir))
        except (KeyError, ValueError):
            pass
    sudo_uid = os.environ.get("SUDO_UID")
    if sudo_uid:
        try:
            uid = int(sudo_uid)
            if uid != 0:
                pw = pwd.getpwuid(uid)
                gid = int(os.environ.get("SUDO_GID", pw.pw_gid))
                return (pw.pw_name, uid, gid, Path(pw.pw_dir))
        except (ValueError, KeyError):
            pass
    return None


def _user_home() -> Path:
    """Home of the invoking (sudo) user, else current user's home."""
    inv = _invoking_user()
    if inv is not None:
        return inv[3]
    return Path.home()


def default_applied_file() -> Path:
    """Local (user) applied file path, resolved for the invoking user."""
    return _user_home() / ".config" / "N0ctOS" / "data" / "patches-applied.txt"


def system_applied_file() -> Path:
    """System-wide applied file path (machine-specific, in local/)."""
    return SYSTEM_APPLIED_FILE


def legacy_applied_file() -> Path:
    """Legacy JSON path, resolved for the invoking user (sudo-safe)."""
    return _user_home() / ".config" / "N0ctOS" / "data" / "patches-applied.json"


def load_patchignore(patches_dir: Path) -> list[str]:
    """Load .patchignore patterns from the patches directory.

    Returns list of patterns (filenames or globs). Lines starting with #
    and empty lines are ignored.
    """
    ignore_file = patches_dir / DEFAULT_PATCHIGNORE
    if not ignore_file.exists():
        return []
    try:
        text = ignore_file.read_text()
    except OSError:
        return []
    patterns = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        patterns.append(line)
    return patterns


def is_patch_ignored(patch_name: str, ignore_patterns: list[str]) -> bool:
    """Check if a patch filename matches any ignore pattern."""
    for pattern in ignore_patterns:
        if fnmatch.fnmatch(patch_name, pattern):
            return True
    return False


# Import-time fallback for back-compat; prefer legacy_applied_file().
LEGACY_APPLIED_FILE = Path.home() / ".config" / "N0ctOS" / "data" / "patches-applied.json"


def _chown_to_root(path: Path):
    """Best-effort chown of path to root:root. No-op when not root.

    The tracking file (and its data dir) must be owned by system/root,
    readonly for users (0444 / 0755). Even though the file lives inside
    the invoking user's home (see _user_home), it is never user-owned:
    real runs always go through sudo, so root creates it root-owned; this
    helper additionally repairs files/dirs a previous run may have left
    user-owned.
    """
    if os.geteuid() != 0:
        return
    try:
        os.chown(path, 0, 0)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Package manager
# ---------------------------------------------------------------------------
#
# Delegates to n0ct-pkg for all package operations. n0ct-pkg handles
# retry logic, sudo, AUR detection, and privilege dropping internally.

def apply_packages(add, remove, dry_run: bool):
    """Remove then install package lists via n0ct-pkg."""
    add = list(add or [])
    remove = list(remove or [])

    if dry_run:
        if remove:
            print(f"[pkg] remove {' '.join(remove)}")
            print(f"  run: n0ct-pkg remove {' '.join(remove)}")
        if add:
            print(f"[pkg] add {' '.join(add)}")
            print(f"  run: n0ct-pkg add {' '.join(add)}")
        return

    # Use n0ct-pkg for package operations (handles retry, sudo, AUR detection)
    if remove:
        print(f"[pkg] remove {' '.join(remove)}")
        cmd = ["n0ct-pkg", "remove"] + remove
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as e:
            raise RuntimeError(f"package remove failed (exit {e.returncode})")
        print("[pkg] remove — ok")

    if add:
        print(f"[pkg] add {' '.join(add)}")
        cmd = ["n0ct-pkg", "add"] + add
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as e:
            raise RuntimeError(f"package install failed (exit {e.returncode})")
        print("[pkg] install — ok")


def merge_packages(patches):
    """Merge package lists, last-op-wins per package.

    Walks patches in order; each add/remove overwrites the package's
    pending state. Returns (net_add, net_remove) in first-seen order.
    """
    state = {}
    for patch in patches:
        pkgs = patch.get("packages") or {}
        for p in pkgs.get("add") or []:
            state[str(p)] = "add"
        for p in pkgs.get("remove") or []:
            state[str(p)] = "remove"
    net_add = [p for p, s in state.items() if s == "add"]
    net_remove = [p for p, s in state.items() if s == "remove"]
    return net_add, net_remove


# ---------------------------------------------------------------------------
# Match language
# ---------------------------------------------------------------------------
#
# Tokens (space-separated in the pattern):
#   ^      any text (leading/trailing/between), non-greedy
#   ^+     any text, at least one char, non-greedy
#   _      variable space (one or more whitespace chars)
#   _?     optional space (zero or more whitespace chars)
#   *      single wildcard char (any one char)
#   {:x:}  the replace slot — always replaced
#   other  literal text
#
# Slot contents:
#   {::}    one or more chars
#   {:*:}   zero or more chars
#   {:d:}   digits
#   {:s:}   whitespace
#
# Rules:
#   - Exactly one slot per pattern.
#   - Matching is within a single line.
#   - Literal text is escaped; only tokens have special meaning.

SLOT_RE = re.compile(r"\{:([^:]*):\}")

SLOT_BODIES = {
    "":   r".+",
    "*":  r".*",
    "d":  r"\d+",
    "s":  r"\s+",
}


def compile_pattern(pattern: str) -> re.Pattern:
    """Compile a match-language string into a regex with one capture group."""
    tokens = pattern.split(" ")
    parts = []
    slot_count = 0

    for tok in tokens:
        if not tok:
            # Double spaces in pattern — treat as a literal-space error.
            raise ValueError(f"empty token in pattern: {pattern!r}")

        m = SLOT_RE.fullmatch(tok)
        if m:
            slot_count += 1
            body = m.group(1)
            if body not in SLOT_BODIES:
                raise ValueError(f"unknown slot body: {tok!r}")
            parts.append(f"({SLOT_BODIES[body]})")
            continue

        if tok == "^+":
            parts.append(r".+?")
        elif tok == "^":
            parts.append(r".*?")
        elif tok == "_?":
            parts.append(r"\s*")
        elif tok == "_":
            parts.append(r"\s+")
        elif tok == "*":
            parts.append(r".")
        else:
            parts.append(re.escape(tok))

    if slot_count != 1:
        raise ValueError(
            f"pattern must contain exactly one {{: :}} slot, "
            f"found {slot_count}: {pattern!r}"
        )

    return re.compile("".join(parts))


# ---------------------------------------------------------------------------
# Conditions
# ---------------------------------------------------------------------------

WHEN_TIMEOUT = 30


def _run_shell_capture(cmd: str, timeout: int):
    """Run a shell cmd, capturing output, killing the group on timeout/Ctrl+C.

    Returns (returncode, stdout, stderr). Raises TimeoutExpired (after
    killing the group) or KeyboardInterrupt (after killing the group).
    Uses its own process group so killpg never touches the runner.
    """
    proc = subprocess.Popen(
        cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, stdin=subprocess.DEVNULL, preexec_fn=os.setpgrp,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        _kill_pgid(proc.pid)
        try:
            out, err = proc.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            out, err = "", ""
        raise subprocess.TimeoutExpired(cmd, timeout)
    except KeyboardInterrupt:
        _kill_pgid(proc.pid)
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            pass
        raise
    return proc.returncode, out, err


def check_when(when, dry_run: bool) -> bool:
    """Return True if op should run. `when` is a shell cmd or list of cmds."""
    if when is None:
        return True
    cmds = when if isinstance(when, list) else [when]
    for cmd in cmds:
        try:
            returncode, _, _ = _run_shell_capture(cmd, WHEN_TIMEOUT)
        except subprocess.TimeoutExpired:
            # A hanging condition must never hang the whole run:
            # treat as failed condition (skip), never abort here.
            print(f"    [when] {cmd!r} → timeout after {WHEN_TIMEOUT}s (fail)")
            return False
        # KeyboardInterrupt propagates (after killing the group) so Ctrl+C
        # aborts the whole run instead of silently skipping.
        ok = returncode == 0
        if dry_run:
            print(f"    [when] {cmd!r} → {'pass' if ok else 'fail'}")
        if not ok:
            return False
    return True


# ---------------------------------------------------------------------------
# File operations
# ---------------------------------------------------------------------------

def op_create(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    overwrite = spec.get("overwrite", False)
    content = spec.get("content", "")
    mode = spec.get("mode")

    if p.exists() and not overwrite:
        if dry_run:
            print(f"[create] {p} — EXISTS, overwrite=false → SKIP")
            return
        raise RuntimeError(f"{p} exists and overwrite=false")

    if dry_run:
        verb = "OVERWRITE" if p.exists() else "CREATE"
        print(f"[create] {p} — {verb}, {len(content)} bytes")
        if mode:
            print(f"         mode: {mode}")
        return

    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(content)
    if mode:
        p.chmod(int(mode, 8))
    print(f"[create] wrote {p}")


def op_delete(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    missing_ok = spec.get("missing_ok", True)

    if not p.exists():
        if missing_ok:
            print(f"[delete] {p} — already gone, skip")
            return
        raise RuntimeError(f"{p} does not exist")

    if dry_run:
        print(f"[delete] {p} — DELETE ({p.stat().st_size} bytes)")
        return

    p.unlink()
    print(f"[delete] removed {p}")


def op_append(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    content = spec.get("content", "")
    newline_before = spec.get("newline_before", True)

    if not p.exists():
        if dry_run:
            print(f"[append] {p} — MISSING → real run would ABORT")
            return
        raise RuntimeError(f"{p} does not exist (append target)")

    existing = p.read_text()
    sep = ""
    if newline_before and existing and not existing.endswith("\n"):
        sep = "\n"

    if dry_run:
        preview = content.splitlines()[0] if content else ""
        print(f"[append] {p} — +{len(content)} bytes, first line: {preview!r}")
        return

    with p.open("a") as f:
        f.write(sep + content)
    print(f"[append] {p}")


def op_replace(spec: dict, dry_run: bool):
    p = Path(spec["path"])
    pattern = spec["match"]
    replacement = spec["replace"]

    if not p.exists():
        if dry_run:
            print(f"[replace] {p}")
            print(f"          target missing → real run would ABORT")
            return
        raise RuntimeError(f"{p} does not exist (replace target)")

    rx = compile_pattern(pattern)
    lines = p.read_text().splitlines(keepends=True)
    matches = []

    for i, line in enumerate(lines):
        m = rx.search(line.rstrip("\n"))
        if m:
            matches.append((i, m))

    if not matches:
        if dry_run:
            print(f"[replace] {p}")
            print(f"          pattern: {pattern!r}")
            print(f"          regex:   {rx.pattern}")
            print(f"          matches: 0  → real run would ABORT")
            return
        raise RuntimeError(
            f"no match in {p} for pattern {pattern!r} "
            f"(compiled: {rx.pattern})"
        )

    if dry_run:
        print(f"[replace] {p}")
        print(f"          pattern: {pattern!r}")
        print(f"          regex:   {rx.pattern}")
        print(f"          matches: {len(matches)}")
        for i, m in matches:
            old = lines[i].rstrip("\n")
            new = rx.sub(lambda mm: mm.group(0)[:mm.start(1) - mm.start(0)]
                         + replacement
                         + mm.group(0)[mm.end(1) - mm.start(0):],
                         old, count=1)
            print(f"          line {i + 1}: {old!r}")
            print(f"                 → {new!r}")
        return

    for i, _ in matches:
        line = lines[i].rstrip("\n")
        new_line = rx.sub(
            lambda mm: mm.group(0)[:mm.start(1) - mm.start(0)]
                       + replacement
                       + mm.group(0)[mm.end(1) - mm.start(0):],
            line,
            count=1,
        )
        # Preserve original newline
        ending = "\n" if lines[i].endswith("\n") else ""
        lines[i] = new_line + ending

    p.write_text("".join(lines))
    print(f"[replace] {p} — {len(matches)} line(s) updated")


def op_symlink(spec: dict, dry_run: bool):
    """Create a symlink from source to target.

    source: the physical file/directory that the symlink points to
    target: the path where the symlink will be created
    overwrite: if true, replace existing target (default: false, skip if exists)
    """
    source = spec["source"]
    target = Path(spec["target"])
    overwrite = spec.get("overwrite", False)

    if target.exists() or target.is_symlink():
        if not overwrite:
            if dry_run:
                print(f"[symlink] {target} -> {source} — EXISTS, overwrite=false → SKIP")
                return
            print(f"[symlink] {target} -> {source} — already exists, skipping")
            return
        # overwrite: true - remove existing
        if dry_run:
            print(f"[symlink] {target} -> {source} — OVERWRITE")
            return
        if target.is_dir() and not target.is_symlink():
            shutil.rmtree(target)
        else:
            target.unlink()

    if dry_run:
        print(f"[symlink] {target} -> {source} — CREATE")
        return

    target.parent.mkdir(parents=True, exist_ok=True)
    # Resolve source relative to target's parent if source is relative
    source_path = Path(source)
    if not source_path.is_absolute():
        source_path = (target.parent / source_path).resolve()
    target.symlink_to(source_path)
    print(f"[symlink] {target} -> {source_path}")


FILE_OPS = {
    "create": op_create,
    "delete": op_delete,
    "append": op_append,
    "replace": op_replace,
    "symlink": op_symlink,
}


def run_file_op(spec: dict, dry_run: bool):
    op = spec.get("op")
    if op not in FILE_OPS:
        raise ValueError(f"unknown file op: {op!r}")
    FILE_OPS[op](spec, dry_run)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def run_command(cmd: dict, dry_run: bool):
    cid = cmd["id"]
    run = cmd["run"]
    timeout = cmd.get("timeout", 300)

    if dry_run:
        first = run.strip().splitlines()[0] if run.strip() else ""
        print(f"[cmd] {cid} — would run: {first}")
        return

    try:
        returncode, _, stderr = _run_shell_capture(run, timeout)
    except subprocess.TimeoutExpired:
        raise RuntimeError(
            f"command {cid!r} timed out after {timeout}s (killed)"
        )
    except KeyboardInterrupt:
        print(f"\n[killed] command {cid!r} — interrupted, child killed",
              file=sys.stderr)
        raise
    if returncode != 0:
        raise RuntimeError(
            f"command {cid!r} failed (exit {returncode})\n"
            f"stderr: {stderr.strip()}"
        )
    print(f"[cmd] {cid} — ok")


# ---------------------------------------------------------------------------
# Single patch
# ---------------------------------------------------------------------------

def run_section(name: str, items, runner, dry_run: bool):
    if not items:
        return
    print(f"\n=== {name} ===")
    for item in items:
        if not check_when(item.get("when"), dry_run):
            label = item.get("id") or item.get("path") or "?"
            print(f"[skip] {label} — when condition failed")
            continue
        runner(item, dry_run)


def load_patch(patch_path: Path, validate_mode: bool = False):
    """Load + validate one patch YAML. Returns the patch dict."""
    patch = yaml.safe_load(Path(patch_path).read_text())
    meta = (patch or {}).get("meta") or {}

    # Validate required scope field
    scope = meta.get("scope")
    if scope not in ("system", "local"):
        raise RuntimeError(
            f"{patch_path}: meta.scope must be 'system' or 'local', got {scope!r}"
        )

    # Validate register field (optional, defaults to false)
    register = meta.get("register", False)
    if not isinstance(register, bool):
        raise RuntimeError(
            f"{patch_path}: meta.register must be boolean (true/false), got {register!r}"
        )

    # Schema validation (if schema available)
    patches_dir = patch_path.parent
    _validate_schema(patch, patches_dir, patch_path.name, validate_mode)

    # Nomenclature check
    _check_nomenclature(patch_path.name, validate_mode)

    return patch


def print_patch_header(patch, dry_run: bool):
    meta = patch.get("meta") or {}
    print(f"patch: {meta.get('name', 'unnamed')}")
    if meta.get("summary"):
        print(f"  {meta['summary']}")
    if dry_run:
        print("  [DRY RUN]")


def apply_file_phases(patch, dry_run: bool, with_packages: bool,
                      with_pre: bool = True):
    """Run pre → pkgs → files → commands → post. Raises on any failure."""
    if with_pre:
        run_section("pre", patch.get("pre") or [], run_command, dry_run)

    if with_packages:
        pkgs = patch.get("packages") or {}
        if pkgs.get("add") or pkgs.get("remove"):
            print("\n=== packages ===")
            apply_packages(pkgs.get("add"), pkgs.get("remove"), dry_run)

    run_section("files", patch.get("files") or [], run_file_op, dry_run)
    run_section("commands", patch.get("commands") or [], run_command, dry_run)
    run_section("post", patch.get("post") or [], run_command, dry_run)


def apply_single_patch(patch_path: Path, dry_run: bool):
    """Apply one patch YAML file. Raises on any failure.

    Explicit file mode: validates scope, but never registers (backward compatible).
    """
    patch = load_patch(patch_path, validate_mode=False)
    scope = patch.get("meta", {}).get("scope")
    print_patch_header(patch, dry_run)
    if scope:
        print(f"  scope: {scope}")
    apply_file_phases(patch, dry_run, with_packages=True, with_pre=True)


# ---------------------------------------------------------------------------
# Applied tracking (plain text, one filename per line)
# ---------------------------------------------------------------------------
#
# The applied file is plain text: one patch filename per line, e.g.
#   1.2.0-aurora.yaml
#   1.2.1-fix.yaml
# Blank lines and lines starting with # are ignored. A legacy JSON list
# file (["a.yaml", ...]) is accepted on read for migration, but writes
# are always plain text.
#
# Permissions: the file lives in the invoking user's home (sudo-safe,
# see _user_home) but is owned by system/root, mode 0444 — readonly for
# users. Writing needs sudo. Parent data dir is created 0755 root-owned
# so users can neither overwrite nor unlink the record.

def load_applied(path: Path):
    """Return the ordered list of applied patch filenames."""
    p = Path(path)
    if not p.exists():
        # Migration: fall back to legacy .json next to the .txt path.
        legacy = p.with_suffix(".json")
        if p.suffix == ".txt" and legacy.exists():
            p = legacy
        elif p == default_applied_file():
            # Check both the sudo-safe dynamic legacy and the import-time
            # constant (old runs under sudo wrote to /root/...).
            dyn_legacy = legacy_applied_file()
            if dyn_legacy.exists():
                p = dyn_legacy
            elif LEGACY_APPLIED_FILE.exists():
                p = LEGACY_APPLIED_FILE
            else:
                return []
        else:
            return []
        if not p.exists():
            return []

    try:
        text = p.read_text()
    except OSError as e:
        raise RuntimeError(f"cannot read {p}: {e} (check permissions)")

    stripped = text.strip()
    if stripped.startswith("["):
        try:
            data = json.loads(text)
        except json.JSONDecodeError as e:
            raise RuntimeError(f"cannot parse {p} as JSON: {e}")
        if not isinstance(data, list):
            raise RuntimeError(f"applied file {p} must be a list or line-per-file")
        names = []
        for entry in data:
            s = str(entry).strip()
            if s and not s.startswith("#"):
                names.append(s)
        return names

    names = []
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        names.append(s)
    return names


def save_applied(path: Path, names):
    """Atomically write the applied list as plain text, root-owned 0444.

    The file lives in the invoking user's home but stays owned by
    system/root, readonly for users. When running as root (the normal
    case — real runs require sudo), the data dir and the file are
    explicitly chown'd to 0:0, repairing any user-owned leftovers.
    Non-root test runs (--no-root-check) leave ownership as-is.
    """
    p = Path(path)
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        try:
            p.parent.chmod(0o755)
        except OSError:
            pass  # best effort; dir may be root-owned
        _chown_to_root(p.parent)
        tmp = p.with_name(p.name + ".tmp")
        body = "".join(n + "\n" for n in names)
        tmp.write_text(body)
        _chown_to_root(tmp)
        tmp.replace(p)
        # replace() preserves tmp's ownership; re-apply in case the
        # platform replaced instead of renamed.
        _chown_to_root(p)
        try:
            p.chmod(0o444)
        except OSError:
            pass
    except OSError as e:
        raise RuntimeError(f"cannot write {p}: {e} (run with sudo?)")


# ---------------------------------------------------------------------------
# Batch mode
# ---------------------------------------------------------------------------
#
# Order:
#   1. all `pre` blocks, file order (backups before anything changes)
#   2. merged packages: last-op-wins per package, remove then install, once
#   3. per file in order: files → commands → post, each registered on success

def _load_applied_system(path: Path):
    """Return the ordered list of applied system patch filenames."""
    return load_applied(path)


def _load_applied_local(path: Path):
    """Return the ordered list of applied local patch filenames."""
    return load_applied(path)


def _save_applied_system(path: Path, names):
    """Atomically write the system applied list as plain text, root-owned 0444."""
    save_applied(path, names)


def _save_applied_local(path: Path, names):
    """Atomically write the local applied list as plain text, root-owned 0444."""
    save_applied(path, names)


def select_patches(patches_dir: Path, applied_system, applied_local, select_all: bool, ignore_patterns: list[str] = None):
    """Return (all_paths, selected_system, selected_local) in filename order.

    If ignore_patterns is provided, patches matching those patterns are
    excluded from the selection (applies to directory scan modes only).

    Patches are partitioned by their meta.scope field into system and local.
    """
    ignore_patterns = ignore_patterns or []
    d = Path(patches_dir)
    if not d.is_dir():
        raise RuntimeError(f"patches dir not found: {d}")
    all_paths = sorted(d.glob("*.yaml"), key=lambda p: p.name)
    # Filter out ignored patches
    filtered_paths = [p for p in all_paths if not is_patch_ignored(p.name, ignore_patterns)]

    # Partition by scope
    system_patches = []
    local_patches = []
    for p in filtered_paths:
        patch = load_patch(p)
        scope = patch.get("meta", {}).get("scope")
        if scope == "system":
            system_patches.append(p)
        elif scope == "local":
            local_patches.append(p)
        else:
            raise RuntimeError(f"{p}: invalid scope {scope!r}")

    if select_all:
        return filtered_paths, system_patches, local_patches

    applied_system_set = set(applied_system)
    applied_local_set = set(applied_local)

    selected_system = [p for p in system_patches if p.name not in applied_system_set]
    selected_local = [p for p in local_patches if p.name not in applied_local_set]

    return filtered_paths, selected_system, selected_local


def run_check(patches_dir: Path, applied_system_file: Path, applied_local_file: Path, dry_run: bool) -> int:
    """Check for pending patches. Exit code: 0=none, 1=pending, 2=error."""
    if not patches_dir.is_dir():
        print(f"patches dir not found: {patches_dir}", file=sys.stderr)
        return 2

    # In check mode, we want to see branch patches but filter out non-patch files
    ignore_patterns = load_patchignore(patches_dir)
    # Don't filter branch patches (00-*.yaml) in check mode - we want to see them
    check_ignore_patterns = [p for p in ignore_patterns if p != "00-*.yaml"]
    all_paths, selected_system, selected_local = select_patches(
        patches_dir, _load_applied_system(applied_system_file), _load_applied_local(applied_local_file),
        select_all=False, ignore_patterns=check_ignore_patterns
    )

    if not all_paths:
        print(f"no patches in {patches_dir}")
        return 0

    applied_system = _load_applied_system(applied_system_file)
    applied_local = _load_applied_local(applied_local_file)

    print(f"patches dir: {patches_dir}")
    print(f"  system: {len([p for p in all_paths if load_patch(p, True).get('meta', {}).get('scope') == 'system'])} total, {len(selected_system)} pending")
    print(f"  local:  {len([p for p in all_paths if load_patch(p, True).get('meta', {}).get('scope') == 'local'])} total, {len(selected_local)} pending")
    print(f"system applied file: {applied_system_file} ({len(applied_system)} applied)")
    print(f"local applied file:  {applied_local_file} ({len(applied_local)} applied)")
    if ignore_patterns:
        print(f"ignored: {', '.join(ignore_patterns)}")

    has_pending = False

    if selected_system:
        has_pending = True
        print("\nPending system patches:")
        for path in selected_system:
            patch = load_patch(path, True)
            meta = patch.get("meta") or {}
            name = meta.get("name", "")
            summary = meta.get("summary", "")
            reg = meta.get("register", False)
            line = f"  {path.name}"
            if name:
                line += f"  ({name}"
            line += f", register={reg})"
            if summary:
                line += f" — {summary}"
            print(line)

    if selected_local:
        has_pending = True
        print("\nPending local patches:")
        for path in selected_local:
            patch = load_patch(path, True)
            meta = patch.get("meta") or {}
            name = meta.get("name", "")
            summary = meta.get("summary", "")
            reg = meta.get("register", False)
            line = f"  {path.name}"
            if name:
                line += f"  ({name}"
            line += f", register={reg})"
            if summary:
                line += f" — {summary}"
            print(line)

    if not has_pending:
        print("No pending patches.")
        return 0

    return 1


def apply_batch(patches_dir: Path, applied_system_file: Path, applied_local_file: Path, dry_run: bool,
                select_all: bool, check_mode: bool = False):
    """Apply a batch of patches with one merged package pass.

    Patches are partitioned by scope (system/local). Packages are merged
    across both scopes. System patches are applied first, then local patches.
    Each scope registers to its own applied file.
    """
    ignore_patterns = load_patchignore(patches_dir)
    all_paths, selected_system, selected_local = select_patches(
        patches_dir,
        _load_applied_system(applied_system_file),
        _load_applied_local(applied_local_file),
        select_all, ignore_patterns
    )
    if not all_paths:
        print(f"no patches in {patches_dir}")
        return

    applied_system = _load_applied_system(applied_system_file)
    applied_local = _load_applied_local(applied_local_file)
    applied_system_set = set(applied_system)
    applied_local_set = set(applied_local)

    mode = "all" if select_all else "diff"
    total_system = len([p for p in all_paths if load_patch(p, False).get("meta", {}).get("scope") == "system"])
    total_local = len([p for p in all_paths if load_patch(p, False).get("meta", {}).get("scope") == "local"])
    print(f"patches dir: {patches_dir} "
          f"({len(selected_system)} system + {len(selected_local)} local selected, "
          f"{total_system} system + {total_local} local total)")
    print(f"system applied file: {applied_system_file} ({len(applied_system)} applied)")
    print(f"local applied file:  {applied_local_file} ({len(applied_local)} applied)")
    print(f"mode: {mode}")
    if ignore_patterns:
        print(f"ignored: {', '.join(ignore_patterns)}")
    if dry_run:
        print("  [DRY RUN — will not register]")

    if not select_all:
        for p in all_paths:
            patch = load_patch(p, False)
            scope = patch.get("meta", {}).get("scope")
            if scope == "system" and p.name in applied_system_set:
                print(f"[skip] {p.name} — already applied (system)")
            elif scope == "local" and p.name in applied_local_set:
                print(f"[skip] {p.name} — already applied (local)")

    if not selected_system and not selected_local:
        print("nothing to do.")
        return

    # Load all selected patches for package merging
    loaded_system = [(p, load_patch(p, False)) for p in selected_system]
    loaded_local = [(p, load_patch(p, False)) for p in selected_local]
    all_loaded = loaded_system + loaded_local

    # 1. pres upfront, file order (all patches)
    for path, patch in all_loaded:
        if patch.get("pre"):
            print(f"\n>>> {path.name} (pre) <<<")
            run_section("pre", patch.get("pre") or [], run_command, dry_run)

    # 2. merged packages across ALL selected patches (system + local), once
    net_add, net_remove = merge_packages([patch for _, patch in all_loaded])
    if net_add or net_remove:
        print("\n=== packages (merged) ===")
        print(f"  from: {', '.join(p.name for p, _ in all_loaded)}")
        if net_remove:
            print(f"  remove: {' '.join(net_remove)}")
        if net_add:
            print(f"  add: {' '.join(net_add)}")
        apply_packages(net_add, net_remove, dry_run)
    else:
        print("\n=== packages (merged) ===\n  nothing to do")

    # 3. Apply system patches first
    if loaded_system:
        print("\n=== system patches ===")
    for path, patch in loaded_system:
        name = path.name
        print(f"\n>>> {name} <<<")
        print_patch_header(patch, dry_run)
        run_section("files", patch.get("files") or [], run_file_op, dry_run)
        run_section("commands", patch.get("commands") or [], run_command, dry_run)
        run_section("post", patch.get("post") or [], run_command, dry_run)

        register = patch.get("meta", {}).get("register", False)
        if dry_run:
            print(f"  [dry-run] would register {name} (system, register={register})")
        elif register:
            if name in applied_system_set:
                print(f"[register] {name} — already listed (system)")
            else:
                applied_system.append(name)
                applied_system_set.add(name)
                _save_applied_system(applied_system_file, applied_system)
                print(f"[register] {name} (system)")
        else:
            print(f"[skip register] {name} (register=false)")

    # 4. Apply local patches second
    if loaded_local:
        print("\n=== local patches ===")
    for path, patch in loaded_local:
        name = path.name
        print(f"\n>>> {name} <<<")
        print_patch_header(patch, dry_run)
        run_section("files", patch.get("files") or [], run_file_op, dry_run)
        run_section("commands", patch.get("commands") or [], run_command, dry_run)
        run_section("post", patch.get("post") or [], run_command, dry_run)

        register = patch.get("meta", {}).get("register", False)
        if dry_run:
            print(f"  [dry-run] would register {name} (local, register={register})")
        elif register:
            if name in applied_local_set:
                print(f"[register] {name} — already listed (local)")
            else:
                applied_local.append(name)
                applied_local_set.add(name)
                _save_applied_local(applied_local_file, applied_local)
                print(f"[register] {name} (local)")
        else:
            print(f"[skip register] {name} (register=false)")

    print("\ndone.")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        description="Apply patch YAML files to the system.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Modes:
  n0ct-patch                          # scan default dir, apply missing (default)
  n0ct-patch -m                       # apply unapplied patches from default dir
  n0ct-patch -a                       # apply all patches from default dir
  n0ct-patch -d /path/to/patches      # scan custom directory
  n0ct-patch patch1.yaml patch2.yaml  # apply explicit files (ignores .patchignore)
  n0ct-patch -c                       # list pending patches (no changes)
  n0ct-patch -c -d /path              # check custom directory
"""
    )
    # Positional: explicit patch files
    ap.add_argument("patches", nargs="*", help="explicit patch YAML files to apply")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="preview changes without applying")
    ap.add_argument("-c", "--check", action="store_true",
                    help="list pending patches (exit 0=none, 1=pending, 2=error)")
    ap.add_argument("-v", "--validate", action="store_true",
                    help="validate patch schema and nomenclature (exit 0=all valid, 1=any error)")
    ap.add_argument("-m", "--apply-missing", action="store_true",
                    help="batch: apply unapplied patches from --patches-dir (default if no args)")
    ap.add_argument("-a", "--all", action="store_true",
                    help="batch: apply every patch, ignore applied file (still registers)")
    ap.add_argument("-p", "--patches-dir", default=str(DEFAULT_PATCHES_DIR),
                    help="directory to scan for patches (default: %(default)s)")
    ap.add_argument("-d", "--dir", dest="custom_dir", metavar="DIR",
                    help="alias for --patches-dir")
    ap.add_argument("-s", "--system-file", default=str(system_applied_file()),
                    help="system-wide applied list (default: %(default)s)")
    ap.add_argument("-l", "--local-file", default=str(default_applied_file()),
                    help="user-local applied list (default: %(default)s)")
    ap.add_argument("--applied-file", dest="applied_file_legacy", default=None,
                    help=argparse.SUPPRESS)  # legacy alias, deprecated
    ap.add_argument("--no-root-check", action="store_true",
                    help="testing only: allow real runs without root")
    args = ap.parse_args()

    # Handle legacy --applied-file alias (maps to --local-file for backward compat)
    applied_local_file = Path(args.local_file)
    if args.applied_file_legacy is not None:
        applied_local_file = Path(args.applied_file_legacy)
    applied_system_file = Path(args.system_file)

    # Handle --dir alias
    patches_dir = Path(args.custom_dir) if args.custom_dir else Path(args.patches_dir)

    # Determine mode
    has_explicit_files = len(args.patches) > 0
    is_batch_mode = args.apply_missing or args.all

    # Default to --apply-missing if no explicit files, no --all, no --check, no --apply-missing explicitly set
    # (i.e., user ran `n0ct-patch` with no args)
    if not has_explicit_files and not args.all and not args.check and not args.apply_missing:
        is_batch_mode = True
        args.apply_missing = True

    # Mutually exclusive checks
    if has_explicit_files and is_batch_mode:
        ap.error("explicit patch files cannot be combined with --apply-missing/--all")
    if has_explicit_files and args.custom_dir:
        ap.error("explicit patch files cannot be combined with --dir/--patches-dir")
    if args.check and has_explicit_files:
        ap.error("--check cannot be used with explicit patch files")

    # Read-only modes (--dry-run, --check, --validate) don't need sudo
    is_read_only = args.dry_run or args.check or args.validate
    if not is_read_only and not args.no_root_check:
        _ensure_sudo()

    try:
        if args.validate:
            # --validate mode: validate patch schema and nomenclature
            exit_code = run_validate(patches_dir, args.patches)
            sys.exit(exit_code)

        if args.check:
            # --check mode: list pending patches
            exit_code = run_check(patches_dir, applied_system_file, applied_local_file, args.dry_run)
            sys.exit(exit_code)

        if has_explicit_files:
            # Explicit file mode: apply each file, ignore .patchignore, no registration
            for patch_file in args.patches:
                apply_single_patch(Path(patch_file), args.dry_run)
            if not args.dry_run:
                print("\ndone.")
        else:
            # Directory scan mode (default dir or --patches-dir/--dir)
            apply_batch(patches_dir, applied_system_file, applied_local_file, args.dry_run,
                        select_all=args.all, check_mode=False)
    except KeyboardInterrupt:
        print("\ninterrupted — nothing registered beyond last [register]",
              file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, ValueError, OSError,
            subprocess.TimeoutExpired) as e:
        print(f"\nFAILED: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
