// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": []
    },
    "gutter": {
        "line_numbers": true
    },
    "soft_wrap": "prefer_line",
    "show_edit_predictions": false,
    "completions": {
        "lsp": true,
    },
    "show_completions_on_input": true,
    "git_panel": {
        "tree_view": true,
        "dock": "right",
    },
    "diagnostics": {
        "button": true,
        "include_warnings": true,
        "inline": {
            "enabled": true,
            "update_debounce_ms": 150,
            "padding": 4,
            "min_column": 0,
            "max_severity": null,
        },
        "cargo": null,
    },
    "terminal": {
        "max_scroll_history_lines": 1000,
        "copy_on_select": true,
        "blinking": "on",
        "cursor_shape": "bar",
        "font_weight": 150.0,
        "dock": "right",
    },
    "project_panel": {
        "dock": "left",
        "hide_root": true,
        "bold_folder_labels": true,
        "indent_size": 13.0,
        "entry_spacing": "standard",
    },
    "active_pane_modifiers": {
        "border_size": 4.0,
        "inactive_opacity": 0.4,
    },
    "window_decorations": "client",
    "tabs": {
        "git_status": false,
        "file_icons": true,
    },
    "title_bar": {
        "show_menus": false,
        "show_branch_icon": true,
    },
    "use_smartcase_search": true,
    "prettier": {
        "allowed": true,
    },
    "colorize_brackets": true,
    "indent_guides": {
        "background_coloring": "indent_aware",
        "coloring": "indent_aware",
        "active_line_width": 4,
        "line_width": 2,
    },
    "tab_size": 2,
    "minimap": {
        "thumb_border": "none",
        "thumb": "always",
        "display_in": "all_editors",
        "show": "auto",
    },
    "autoscroll_on_clicks": true,
    "sticky_scroll": {
        "enabled": false,
    },
    "which_key": {
        "enabled": true,
    },
    "minimum_contrast_for_highlights": 70.0,
    "text_rendering_mode": "platform_default",
    "ui_font_weight": 200.0,
    "buffer_font_weight": 450.0,
    "buffer_font_family": "GeistMono Nerd Font Mono",
    "ui_font_family": "ProFontWindows Nerd Font Propo",
    "telemetry": {
        "diagnostics": true,
        "metrics": false,
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "base_keymap": "VSCode",
    "preview_tabs": {
        "enable_preview_from_file_finder": true,
    },
    "cursor_blink": true,
    "autosave": {
        "after_delay": {
            "milliseconds": 101,
        },
    },
    "auto_indent_on_paste": true,
    "icon_theme": "Material Icon Theme",
    "ui_font_size": 16.0,
    "buffer_font_size": 14.0,
    "theme": "Ayu Dark",
}
