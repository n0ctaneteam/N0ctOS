# installers/.gitignore — explicit include list (no-bloat design)
# Exclude all, then include only listed files.
# TO ADD: append !<path> (relative to this dir)
*
!*/
!.gitignore
local
local/**
__pycache__
__pycache__/**
!0-base.sh
!1-packages.sh
!2-non_repo_pkgs.sh
!3.1-configs.sh
!3.2-bin.sh
!3.3-os_release_link.sh
!3-dots_install.sh
