pragma Singleton

import QtQuick
import Quickshell

Singleton {
    id: root

    // ============================================================
    // DEBUG
    // ============================================================

    readonly property bool debugLogging:
        ConfigStore.debugLogging

    // ============================================================
    // DEFAULT FILE
    // ============================================================

    readonly property string defaultFileKey:
        ConfigStore.defaultFileKey

    readonly property string configPath:
        ConfigStore.configPath

    // ============================================================
    // REACTIVE DATA
    // ============================================================

    readonly property var data:
        ConfigStore.document

    readonly property var documents:
        ConfigStore.documents

    readonly property bool ready:
        ConfigStore.ready

    readonly property bool writing:
        ConfigStore.writing

    readonly property bool dirty:
        ConfigStore.dirty

    readonly property int revision:
        ConfigStore.revision

    // ============================================================
    // REGISTERED PATHS
    // ============================================================

    readonly property var paths:
        ConfigStore.paths

    readonly property var pathKeys:
        ConfigStore.pathKeys

    // ============================================================
    // SIGNALS
    // ============================================================

    signal externalReload()
    signal saveError(string reason)

    signal externalReloadFor(string fileKey)
    signal saveErrorFor(string fileKey, string reason)

    /*
     * Public Config signal.
     *
     * NOTE:
     * ConfigStore intentionally uses documentUpdated(), not
     * documentChanged(), because "documentChanged" is already
     * generated by the QML document property.
     */
    signal documentChanged(string fileKey)

    // ============================================================
    // STORE SIGNALS
    // ============================================================

    Connections {
        target: ConfigStore

        function onExternalReload(fileKey) {
            root._debug(
                "RELOAD",
                "External reload completed:",
                fileKey,
                "->",
                ConfigStore.pathFor(fileKey)
            )

            root.externalReload()
            root.externalReloadFor(fileKey)
        }

        function onSaveError(fileKey, reason) {
            root._warn(
                "SAVE",
                "Save failed:",
                fileKey,
                "->",
                reason
            )

            root.saveError(reason)
            root.saveErrorFor(
                fileKey,
                reason
            )
        }

        function onDocumentUpdated(fileKey) {
            root._debug(
                "DATA",
                "Document updated:",
                fileKey,
                "revision:",
                ConfigStore.revisionFor(fileKey)
            )

            root.documentChanged(
                fileKey
            )
        }
    }

    // ============================================================
    // PATH REGISTRY
    // ============================================================

    /*
     * CREATE
     *
     * Adds a new logical file key.
     *
     * Example:
     *
     * Config.registerPath(
     *     "networkConfig",
     *     "~/.config/N0ctOS/network.json"
     * )
     */
    function registerPath(
        fileKey,
        path
    ) {
        root._debug(
            "PATH",
            "Registering path:",
            fileKey,
            "->",
            path
        )

        const result =
            ConfigStore.registerPath(
                fileKey,
                path
            )

        if (!result) {
            root._warn(
                "PATH",
                "Failed to register path:",
                fileKey,
                "->",
                path
            )
        } else {
            root._debug(
                "PATH",
                "Path registered:",
                fileKey,
                "->",
                ConfigStore.pathFor(fileKey)
            )
        }

        return result
    }

    /*
     * CREATE MANY
     */
    function registerPaths(
        pathTable
    ) {
        root._debug(
            "PATH",
            "Registering path table:",
            JSON.stringify(
                pathTable || {}
            )
        )

        const result =
            ConfigStore.registerPaths(
                pathTable
            )

        if (!result) {
            root._warn(
                "PATH",
                "One or more paths failed to register."
            )
        }

        return result
    }

    /*
     * READ
     */
    function hasPath(fileKey) {
        return ConfigStore.hasPath(
            fileKey
        )
    }

    function pathFor(fileKey) {
        return ConfigStore.pathFor(
            fileKey
        )
    }

    /*
     * UPDATE
     *
     * Changes the physical path associated
     * with an existing non-default file key.
     */
    function updatePath(
        fileKey,
        path
    ) {
        root._debug(
            "PATH",
            "Updating path:",
            fileKey,
            "->",
            path
        )

        const result =
            ConfigStore.updatePath(
                fileKey,
                path
            )

        if (!result) {
            root._warn(
                "PATH",
                "Failed to update path:",
                fileKey,
                "->",
                path
            )
        } else {
            root._debug(
                "PATH",
                "Path updated:",
                fileKey,
                "->",
                ConfigStore.pathFor(fileKey)
            )
        }

        return result
    }

    /*
     * DELETE
     *
     * Removes an existing non-default file key.
     */
    function removePath(fileKey) {
        root._debug(
            "PATH",
            "Removing path:",
            fileKey
        )

        const result =
            ConfigStore.removePath(
                fileKey
            )

        if (!result) {
            root._warn(
                "PATH",
                "Failed to remove path:",
                fileKey
            )
        } else {
            root._debug(
                "PATH",
                "Path removed:",
                fileKey
            )
        }

        return result
    }

    // ============================================================
    // READ
    // ============================================================

    function get(
        path,
        fallbackValue,
        fileKey
    ) {
        return ConfigStore.get(
            path,
            fallbackValue,
            fileKey
        )
    }

    function has(
        path,
        fileKey
    ) {
        return ConfigStore.has(
            path,
            fileKey
        )
    }

    function section(
        path,
        fallbackValue,
        fileKey
    ) {
        return ConfigStore.get(
            path,
            fallbackValue === undefined
                ? {}
                : fallbackValue,
            fileKey
        )
    }

    function documentFor(fileKey) {
        return ConfigStore.documentFor(
            fileKey
        )
    }

    function readyFor(fileKey) {
        return ConfigStore.readyFor(
            fileKey
        )
    }

    function writingFor(fileKey) {
        return ConfigStore.writingFor(
            fileKey
        )
    }

    function dirtyFor(fileKey) {
        return ConfigStore.dirtyFor(
            fileKey
        )
    }

    function revisionFor(fileKey) {
        return ConfigStore.revisionFor(
            fileKey
        )
    }

    // ============================================================
    // WRITE
    // ============================================================

    function set(
        path,
        value,
        fileKey
    ) {
        root._debug(
            "WRITE",
            "set():",
            fileKey || root.defaultFileKey,
            "->",
            path
        )

        const result =
            ConfigStore.set(
                path,
                value,
                fileKey
            )

        if (!result) {
            root._warn(
                "WRITE",
                "set() failed:",
                fileKey || root.defaultFileKey,
                "->",
                path
            )
        }

        return result
    }

    function update(
        section,
        patch,
        fileKey
    ) {
        root._debug(
            "WRITE",
            "update():",
            fileKey || root.defaultFileKey,
            "->",
            section
        )

        const result =
            ConfigStore.update(
                section,
                patch,
                fileKey
            )

        if (!result) {
            root._warn(
                "WRITE",
                "update() failed:",
                fileKey || root.defaultFileKey,
                "->",
                section
            )
        }

        return result
    }

    function remove(
        path,
        fileKey
    ) {
        root._debug(
            "WRITE",
            "remove():",
            fileKey || root.defaultFileKey,
            "->",
            path
        )

        const result =
            ConfigStore.remove(
                path,
                fileKey
            )

        if (!result) {
            root._warn(
                "WRITE",
                "remove() failed:",
                fileKey || root.defaultFileKey,
                "->",
                path
            )
        }

        return result
    }

    // ============================================================
    // FILE CONTROL
    // ============================================================

    function save(fileKey) {
        const key =
            fileKey || root.defaultFileKey

        root._debug(
            "WRITE",
            "save():",
            key,
            "->",
            ConfigStore.pathFor(key)
        )

        const result =
            ConfigStore.save(
                fileKey
            )

        if (!result) {
            root._warn(
                "WRITE",
                "save() failed:",
                key
            )
        }

        return result
    }

    function reload(fileKey) {
        const key =
            fileKey || root.defaultFileKey

        root._debug(
            "LOAD",
            "Manual reload requested:",
            key,
            "->",
            ConfigStore.pathFor(key)
        )

        const result =
            ConfigStore.reload(
                fileKey
            )

        if (!result) {
            root._warn(
                "LOAD",
                "reload() failed:",
                key
            )
        }

        return result
    }

    function reloadAll() {
        root._debug(
            "LOAD",
            "Manual reload requested for all registered files."
        )

        const result =
            ConfigStore.reloadAll()

        if (!result) {
            root._warn(
                "LOAD",
                "reloadAll() completed with one or more failures."
            )
        }

        return result
    }

    // ============================================================
    // LOGGING
    // ============================================================

    function _debug() {
        if (!root.debugLogging)
            return

        const args =
            Array.prototype.slice.call(
                arguments
            )

        console.debug(
            "[N0ctOS Config]",
            ...args
        )
    }

    function _warn() {
        const args =
            Array.prototype.slice.call(
                arguments
            )

        console.warn(
            "[N0ctOS Config]",
            ...args
        )
    }
}